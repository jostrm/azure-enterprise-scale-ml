{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aifactory:dual-graph:structural:v1",
  "title": "AI Factory structural evidence graph",
  "type": "object",
  "required": ["directed", "multigraph", "graph", "nodes", "links"],
  "properties": {
    "directed": {"const": true},
    "multigraph": {"const": true},
    "graph": {"type": "object", "required": ["schema_version"], "properties": {"schema_version": {"const": 1}}},
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "kind", "source_file", "evidence", "resolution"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "label": {"type": "string"},
          "kind": {"type": "string"},
          "source_file": {"type": "string"},
          "line": {"type": "integer", "minimum": 1},
          "cell": {"type": "integer", "minimum": 1},
          "evidence": {"enum": ["static", "explicit", "inferred"]},
          "resolution": {"enum": ["resolved", "external", "unresolved"]}
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "target", "relation", "source_file", "evidence", "resolution"],
        "properties": {
          "source": {"type": "string"},
          "target": {"type": "string"},
          "relation": {"type": "string"},
          "source_file": {"type": "string"},
          "evidence": {"enum": ["static", "explicit", "inferred"]},
          "resolution": {"enum": ["resolved", "external", "unresolved"]}
        }
      }
    }
  }
}
