{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.invalid/tutorialapp/videos.schema.json",
  "title": "Protected TutorialApp video metadata (not media URLs)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogRevision", "tutorialId", "videos"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalogRevision": { "$ref": "#/$defs/identifier" },
    "tutorialId": { "$ref": "#/$defs/identifier" },
    "videos": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["videoId", "scenarioId", "title", "displayOrder", "mediaRef"],
        "properties": {
          "videoId": { "$ref": "#/$defs/identifier" },
          "scenarioId": { "type": "string", "pattern": "^scenario-[1-6]$" },
          "title": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
          "displayOrder": { "type": "integer", "minimum": 1, "maximum": 100, "description": "Unique across the entire catalog; one video per scenario is its primary recording." },
          "mediaRef": { "$ref": "#/$defs/identifier" },
          "description": { "type": "string", "maxLength": 4000 },
          "durationSeconds": { "type": "number", "exclusiveMinimum": 0, "description": "Include only a duration verified from the actual recording." },
          "language": { "type": "string", "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
          "posterMediaRef": { "$ref": "#/$defs/identifier" },
          "captionMediaRef": { "$ref": "#/$defs/identifier" }
        }
      }
    }
  },
  "$defs": {
    "identifier": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$" }
  }
}
