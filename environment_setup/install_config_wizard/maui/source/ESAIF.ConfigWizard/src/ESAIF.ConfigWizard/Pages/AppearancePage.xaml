<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ESAIF.ConfigWizard.Pages.AppearancePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ESAIF.ConfigWizard.Controls"
    Title="Appearance"
    Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14" MaximumWidthRequest="980">
            <controls:AppHeader
                Title="Appearance"
                Subtitle="Choose how the configuration workspace looks on this device."
                TrailingText="{Binding CurrentThemeLabel}" />

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Color theme" Style="{StaticResource SectionTitle}" />
                    <Label
                        Text="Your choice is saved locally and applied immediately across every page."
                        Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Animate status lights" Style="{StaticResource SectionTitle}" />
                        <Label
                            Text="Gentle rings highlight selections and verified connections, not data updates. Turning them off leaves steady lights and labels. This changes no data, refresh behavior, or business settings. Windows animation preferences are also respected."
                            Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                    <Switch Grid.Column="1" IsToggled="{Binding AnimateStatusLights}"
                            SemanticProperties.Description="Animate status lights" />
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <Border
                    Grid.Column="0"
                    Padding="18"
                    BackgroundColor="{DynamicResource Surface}"
                    Stroke="{DynamicResource Border}"
                    StrokeShape="RoundRectangle 18">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsSystemSelected}" Value="True">
                            <Setter Property="Stroke" Value="{DynamicResource Primary}" />
                            <Setter Property="StrokeThickness" Value="3" />
                            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceSelected}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectSystemCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="12">
                        <Border HeightRequest="96" Background="{DynamicResource HeroBrush}" StrokeThickness="0" StrokeShape="RoundRectangle 13">
                            <Grid ColumnDefinitions="*,*">
                                <BoxView Color="#F7F6FA" />
                                <BoxView Grid.Column="1" Color="#1B1820" />
                                <Label Grid.ColumnSpan="2" Text="A" FontSize="35" FontAttributes="Bold" TextColor="{DynamicResource Primary}" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <Label Text="System" FontAttributes="Bold" FontSize="17" />
                        <Label Text="Follow the Windows light or dark setting." Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border
                    Grid.Column="1"
                    Padding="18"
                    BackgroundColor="{DynamicResource Surface}"
                    Stroke="{DynamicResource Border}"
                    StrokeShape="RoundRectangle 18">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsLightSelected}" Value="True">
                            <Setter Property="Stroke" Value="{DynamicResource Primary}" />
                            <Setter Property="StrokeThickness" Value="3" />
                            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceSelected}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectLightCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="12">
                        <Border HeightRequest="96" BackgroundColor="#F7F6FA" Stroke="#E1DDE7" StrokeShape="RoundRectangle 13">
                            <Grid>
                                <Border Margin="15" BackgroundColor="White" Stroke="#E1DDE7" StrokeShape="RoundRectangle 9" />
                                <Label Text="Aa" FontSize="27" FontAttributes="Bold" TextColor="#4F378B" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <Label Text="Light" FontAttributes="Bold" FontSize="17" />
                        <Label Text="Bright canvas with crisp purple accents." Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border
                    Grid.Column="2"
                    Padding="18"
                    BackgroundColor="{DynamicResource Surface}"
                    Stroke="{DynamicResource Border}"
                    StrokeShape="RoundRectangle 18">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsDarkSelected}" Value="True">
                            <Setter Property="Stroke" Value="{DynamicResource Primary}" />
                            <Setter Property="StrokeThickness" Value="3" />
                            <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceSelected}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectDarkCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="12">
                        <Border HeightRequest="96" BackgroundColor="#121016" Stroke="#403A48" StrokeShape="RoundRectangle 13">
                            <Grid>
                                <Border Margin="15" BackgroundColor="#1B1820" Stroke="#403A48" StrokeShape="RoundRectangle 9" />
                                <Label Text="Aa" FontSize="27" FontAttributes="Bold" TextColor="#B9A7FF" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <Label Text="Dark" FontAttributes="Bold" FontSize="17" />
                        <Label Text="Low-glare surfaces with luminous violet accents." Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
