<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ESAIF.ConfigWizard.Pages.ScaleSetsPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ESAIF.ConfigWizard.Controls"
    Title="Scale sets"
    Shell.NavBarIsVisible="False">
    <Grid Padding="24" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
        <controls:AppHeader
            Grid.Row="0"
            Title="Saved scale sets"
            Subtitle="Reuse shared subscription, network, region, and common-resource settings." />
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
            <Label
                Text="Shared configurations"
                Style="{StaticResource SectionTitle}"
                VerticalOptions="Center" />
            <Button
                Grid.Column="1"
                Text="Show saved"
                Command="{Binding RefreshCommand}"
                Style="{StaticResource SecondaryButton}" />
        </Grid>
        <controls:TechnicalLabel Caption="Status Message" Grid.Row="2" Value="{Binding StatusMessage}" TextColor="{DynamicResource Muted}" />
        <CollectionView Grid.Row="3" ItemsSource="{Binding ScaleSets}" SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Margin="18" Text="Choose an AI Factory folder in the wizard, then refresh." TextColor="{DynamicResource Muted}" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <controls:GlowCard IsSelected="{Binding IsSelected}">
                    <Border Style="{StaticResource CardBorder}">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Stroke" Value="#22BBD0" />
                                <Setter Property="BackgroundColor" Value="{DynamicResource SurfaceSelected}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="12">
                            <HorizontalStackLayout Spacing="10">
                                <controls:TechnicalLabel Caption="Label" Value="{Binding Label}" FontAttributes="Bold" FontSize="17" VerticalOptions="Center" />
                                <controls:StatusLight Label="{Binding VerificationLabel}" LightColor="{Binding VerificationColor}"
                                    IsPulsing="{Binding IsResourceGroupVerified}"
                                    ToolTipProperties.Text="{Binding VerificationDetails}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Grid.Column="1" Grid.RowSpan="3" Spacing="10" VerticalOptions="Center">
                            <Button Text="Link to RG" Clicked="OnOpenResourceGroupClicked"
                                    CommandParameter="{Binding .}" IsEnabled="{Binding HasResourceGroupLink}"
                                    Style="{StaticResource SecondaryButton}"
                                    ToolTipProperties.Text="{Binding ResourceGroupLinkHint}" />
                            <Button
                                Text="Load"
                                Command="{Binding Source={x:Reference Root}, Path=BindingContext.LoadScaleSetCommand}"
                                CommandParameter="{Binding .}"
                                VerticalOptions="Center" />
                            <Button Text="Delete config" Clicked="OnDeleteConfigurationClicked"
                                    CommandParameter="{Binding .}"
                                    IsEnabled="{Binding Source={x:Reference Root}, Path=BindingContext.IsNotBusy}"
                                    Style="{StaticResource SecondaryButton}"
                                    ToolTipProperties.Text="Delete only the saved scale-set snapshot. Common Azure resources, projects and exported variables remain unchanged." />
                            </HorizontalStackLayout>
                            <controls:TechnicalLabel Caption="Factory folder" Conceal="True"
                                Grid.Row="1"
                                Value="{Binding Folder}"
                                Style="{StaticResource MutedLabel}"
                                ToolTipProperties.Text="{Binding Folder}"
                                LineBreakMode="TailTruncation" />
                            <controls:TechnicalLabel Caption="Configuration file" Conceal="True"
                                Grid.Row="2"
                                Value="{Binding Path}"
                                Style="{StaticResource MutedLabel}"
                                LineBreakMode="TailTruncation" />
                        </Grid>
                    </Border>
                    </controls:GlowCard>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
