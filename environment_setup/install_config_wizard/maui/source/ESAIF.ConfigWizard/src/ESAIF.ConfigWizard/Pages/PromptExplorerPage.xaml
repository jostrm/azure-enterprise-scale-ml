<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ESAIF.ConfigWizard.Pages.PromptExplorerPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ESAIF.ConfigWizard.Controls"
    Title="Prompt Explorer"
    Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14" MaximumWidthRequest="1450">
            <controls:AppHeader
                Title="Prompt Explorer"
                Subtitle="Inspect local request and token telemetry without changing operational data."
                TrailingText="{Binding SourceLabel}" />

            <Border
                Padding="14"
                BackgroundColor="{DynamicResource SurfaceSelected}"
                Stroke="{DynamicResource Primary}"
                StrokeShape="RoundRectangle 12">
                <VerticalStackLayout Spacing="3">
                    <Label Text="Privacy" FontAttributes="Bold" TextColor="{DynamicResource PrimaryStrong}" />
                    <Label
                        Text="Prompt telemetry is read from local SQLite. Prompts and responses are not sent to an external classification service."
                        LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>

            <Border IsVisible="{Binding IsMissingFolder}" Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="AI Factory folder required" Style="{StaticResource SectionTitle}" />
                    <controls:TechnicalLabel Caption="Missing Folder Message" Value="{Binding MissingFolderMessage}" Style="{StaticResource MutedLabel}" />
                    <Button
                        Text="Open Configuration wizard"
                        Command="{Binding OpenWizardCommand}"
                        HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout>
                            <Label Text="Prompt filters" Style="{StaticResource SectionTitle}" />
                            <Label Text="All is sent to the API as no filter." Style="{StaticResource MutedLabel}" />
                        </VerticalStackLayout>
                        <Border
                            Grid.Column="1"
                            Padding="11,6"
                            BackgroundColor="{DynamicResource SurfaceSelected}"
                            Stroke="{DynamicResource Primary}"
                            StrokeShape="RoundRectangle 12">
                            <controls:TechnicalLabel Caption="Source Label" Value="{Binding SourceLabel}" FontAttributes="Bold" TextColor="{DynamicResource PrimaryStrong}" />
                        </Border>
                    </Grid>
                    <Border Style="{StaticResource InputBorder}">
                        <SearchBar
                            Text="{Binding SearchText}"
                            Placeholder="Search prompt, response, or operation ID"
                            SearchCommand="{Binding SearchCommand}" />
                    </Border>
                    <FlexLayout Direction="Row" Wrap="Wrap" AlignItems="Start">
                        <Border Style="{StaticResource InputBorder}" WidthRequest="210" Margin="0,0,8,8">
                            <controls:TechnicalPicker Title="Project" ItemsSource="{Binding Projects}" SelectedItem="{Binding SelectedProject}" />
                        </Border>
                        <Border Style="{StaticResource InputBorder}" WidthRequest="210" Margin="0,0,8,8">
                            <controls:TechnicalPicker Title="Environment" ItemsSource="{Binding Environments}" SelectedItem="{Binding SelectedEnvironment}" />
                        </Border>
                        <Border Style="{StaticResource InputBorder}" WidthRequest="210" Margin="0,0,8,8">
                            <controls:TechnicalPicker Title="Model" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" />
                        </Border>
                        <Border Style="{StaticResource InputBorder}" WidthRequest="210" Margin="0,0,8,8">
                            <controls:TechnicalPicker Title="Category" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" />
                        </Border>
                        <Border Style="{StaticResource InputBorder}" WidthRequest="180" Margin="0,0,8,8">
                            <controls:TechnicalPicker Title="Status" ItemsSource="{Binding SuccessOptions}" SelectedItem="{Binding SelectedSuccess}" />
                        </Border>
                        <Button Text="Search" Command="{Binding SearchCommand}" Margin="0,0,8,8" />
                        <Button Text="Clear" Command="{Binding ClearCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" />
                    </FlexLayout>
                    <controls:TechnicalLabel Caption="Status Message" Value="{Binding StatusMessage}" Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>
            </Border>

            <FlexLayout Direction="Row" Wrap="Wrap" JustifyContent="SpaceBetween">
                <Border Style="{StaticResource CardBorder}" WidthRequest="220" Margin="0,0,8,8">
                    <VerticalStackLayout>
                        <Label Text="Requests" Style="{StaticResource MutedLabel}" />
                        <controls:TechnicalLabel Caption="Requests" Value="{Binding Requests}" FontSize="23" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource CardBorder}" WidthRequest="220" Margin="0,0,8,8">
                    <VerticalStackLayout>
                        <Label Text="Input tokens" Style="{StaticResource MutedLabel}" />
                        <controls:TechnicalLabel Caption="Input Tokens" Value="{Binding InputTokens}" FontSize="23" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource CardBorder}" WidthRequest="220" Margin="0,0,8,8">
                    <VerticalStackLayout>
                        <Label Text="Cached input" Style="{StaticResource MutedLabel}" />
                        <controls:TechnicalLabel Caption="Cached Tokens" Value="{Binding CachedTokens}" FontSize="23" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource CardBorder}" WidthRequest="220" Margin="0,0,8,8">
                    <VerticalStackLayout>
                        <Label Text="Output tokens" Style="{StaticResource MutedLabel}" />
                        <controls:TechnicalLabel Caption="Output Tokens" Value="{Binding OutputTokens}" FontSize="23" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
                <Border Style="{StaticResource CardBorder}" WidthRequest="220" Margin="0,0,0,8">
                    <VerticalStackLayout>
                        <Label Text="Success rate" Style="{StaticResource MutedLabel}" />
                        <controls:TechnicalLabel Caption="Success Rate" Value="{Binding SuccessRate}" FontSize="23" FontAttributes="Bold" />
                    </VerticalStackLayout>
                </Border>
            </FlexLayout>

            <Grid
                x:Name="PromptLayout"
                ColumnDefinitions="5*,4*"
                RowDefinitions="Auto"
                ColumnSpacing="14"
                RowSpacing="14">
                <Border x:Name="ListPane" Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="9">
                        <Label Text="Prompt records" Style="{StaticResource SectionTitle}" />
                        <CollectionView
                            HeightRequest="620"
                            ItemsSource="{Binding Rows}"
                            SelectedItem="{Binding SelectedPrompt, Mode=TwoWay}"
                            SelectionMode="Single">
                            <CollectionView.EmptyView>
                                <Label Margin="12" Text="No prompt telemetry found." Style="{StaticResource MutedLabel}" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,0,9"
                                        Padding="13"
                                        BackgroundColor="{DynamicResource SurfaceMuted}"
                                        Stroke="{DynamicResource Border}"
                                        StrokeShape="RoundRectangle 12">
                                        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="10" RowSpacing="4">
                                            <controls:TechnicalLabel Caption="Prompt"
                                                Value="{Binding Prompt}"
                                                FontAttributes="Bold"
                                                MaxLines="2"
                                                LineBreakMode="TailTruncation" />
                                            <controls:TechnicalLabel Caption="Timestamp" Grid.Column="1" Value="{Binding Timestamp}" Style="{StaticResource MutedLabel}" />
                                            <controls:TechnicalLabel Caption="Category"
                                                Grid.Row="1"
                                                Value="{Binding Category, StringFormat='Category: {0}'}"
                                                Style="{StaticResource MutedLabel}" />
                                            <controls:TechnicalLabel Caption="Model"
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Value="{Binding Model}"
                                                Style="{StaticResource MutedLabel}" />
                                            <HorizontalStackLayout Grid.Row="2" Grid.ColumnSpan="2" Spacing="8">
                                                <controls:TechnicalLabel Caption="Project Number" Value="{Binding ProjectNumber, StringFormat='Project {0}'}" Style="{StaticResource MutedLabel}" />
                                                <controls:TechnicalLabel Caption="Environment" Value="{Binding Environment, StringFormat='Env {0}'}" Style="{StaticResource MutedLabel}" />
                                                <controls:TechnicalLabel Caption="Total Tokens" Value="{Binding TotalTokens, StringFormat='Tokens {0:N0}'}" Style="{StaticResource MutedLabel}" />
                                                <controls:TechnicalLabel Caption="Latency Milliseconds" Value="{Binding LatencyMilliseconds, StringFormat='{0:0} ms'}" Style="{StaticResource MutedLabel}" />
                                                <Label Text="Success" TextColor="{DynamicResource Success}" FontAttributes="Bold">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding Success}" Value="False">
                                                            <Setter Property="Text" Value="Error" />
                                                            <Setter Property="TextColor" Value="{DynamicResource Danger}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <Border
                    x:Name="DetailPane"
                    Grid.Column="1"
                    Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Selected prompt" Style="{StaticResource SectionTitle}" />
                        <controls:TechnicalLabel Caption="Timestamp"
                            IsVisible="{Binding HasSelection}"
                            Value="{Binding SelectedPrompt.Timestamp, StringFormat='Recorded {0}'}"
                            Style="{StaticResource MutedLabel}" />
                        <controls:TechnicalLabel Caption="Prompt"
                            IsVisible="{Binding HasSelection}"
                            Value="{Binding SelectedPrompt.Prompt}"
                            LineBreakMode="WordWrap" />
                        <BoxView IsVisible="{Binding HasSelection}" HeightRequest="1" Color="{DynamicResource Border}" />
                        <Label IsVisible="{Binding HasSelection}" Text="Response" FontAttributes="Bold" />
                        <controls:TechnicalLabel Caption="Response"
                            IsVisible="{Binding HasSelection}"
                            Value="{Binding SelectedPrompt.Response}"
                            LineBreakMode="WordWrap" />
                        <BoxView IsVisible="{Binding HasSelection}" HeightRequest="1" Color="{DynamicResource Border}" />
                        <Label IsVisible="{Binding HasSelection}" Text="Identifiers" FontAttributes="Bold" />
                        <controls:TechnicalLabel Caption="Operation id" IsVisible="{Binding HasSelection}" Value="{Binding SelectedPrompt.OperationId, StringFormat='Operation: {0}'}" Style="{StaticResource MutedLabel}" />
                        <controls:TechnicalLabel Caption="Conversation id" IsVisible="{Binding HasSelection}" Value="{Binding SelectedPrompt.ConversationId, StringFormat='Conversation: {0}'}" Style="{StaticResource MutedLabel}" />
                        <controls:TechnicalLabel Caption="Response id" IsVisible="{Binding HasSelection}" Value="{Binding SelectedPrompt.ResponseId, StringFormat='Response: {0}'}" Style="{StaticResource MutedLabel}" />
                        <controls:TechnicalLabel Caption="Source" IsVisible="{Binding HasSelection}" Value="{Binding SelectedPrompt.Source, StringFormat='Source: {0}'}" Style="{StaticResource MutedLabel}" />
                        <controls:TechnicalLabel Caption="Error Type" IsVisible="{Binding HasSelection}" Value="{Binding SelectedPrompt.ErrorType, StringFormat='Error: {0}'}" TextColor="{DynamicResource Danger}" />
                        <BoxView IsVisible="{Binding HasSelection}" HeightRequest="1" Color="{DynamicResource Border}" />
                        <Label IsVisible="{Binding HasSelection}" Text="Token breakdown" FontAttributes="Bold" />
                        <controls:TechnicalLabel Caption="Input Tokens" IsVisible="{Binding HasSelection}" Value="{Binding SelectedPrompt.InputTokens, StringFormat='Input: {0:N0}'}" />
                        <controls:TechnicalLabel Caption="Cached Input Tokens" IsVisible="{Binding HasSelection}" Value="{Binding SelectedPrompt.CachedInputTokens, StringFormat='Cached input: {0:N0}'}" />
                        <controls:TechnicalLabel Caption="Output Tokens" IsVisible="{Binding HasSelection}" Value="{Binding SelectedPrompt.OutputTokens, StringFormat='Output: {0:N0}'}" />
                        <controls:TechnicalLabel Caption="Total Tokens" IsVisible="{Binding HasSelection}" Value="{Binding SelectedPrompt.TotalTokens, StringFormat='Total: {0:N0}'}" />
                        <controls:TechnicalLabel Caption="Latency Milliseconds"
                            IsVisible="{Binding HasSelection}"
                            Value="{Binding SelectedPrompt.LatencyMilliseconds, StringFormat='Latency: {0:0} ms'}" />
                        <Label
                            Text="Select a prompt record to inspect its complete local telemetry."
                            IsVisible="{Binding HasNoSelection}"
                            Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
