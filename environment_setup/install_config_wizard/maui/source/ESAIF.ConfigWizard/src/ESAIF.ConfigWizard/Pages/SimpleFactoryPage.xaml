<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ESAIF.ConfigWizard.Pages.SimpleFactoryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ESAIF.ConfigWizard.Controls"
    Title="Simple Mode" Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <controls:SimpleFactoryAccountConverter x:Key="AccountLabels" />
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="8" MaximumWidthRequest="760">
            <controls:AppHeader Title="Create an AI Factory" Subtitle="Private · Dev · GitHub Actions" />
            <FlexLayout Direction="Row" Wrap="Wrap">
                <Button Text="Open advanced configuration" Clicked="OnAdvancedClicked" Style="{StaticResource SecondaryButton}"
                        AutomationId="SimpleOpenAdvanced" Margin="0,0,10,4" />
                <Button Text="Reload sign-ins" Command="{Binding ReloadCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,4" />
            </FlexLayout>
            <controls:TechnicalButton Value="{Binding MoreInfoLabel}" Command="{Binding ToggleMoreInfoCommand}"
                    Style="{StaticResource SecondaryButton}" HorizontalOptions="Start" AutomationId="SimpleMoreInfo" />
            <VerticalStackLayout IsVisible="{Binding ShowMoreInfo}" Spacing="4">
                <Label Text="This is a separate draft. Advanced configuration is not changed or reused." FontSize="12" />
                <Label Text="Uses the bundled Python API on Windows and cached Azure CLI/GitHub CLI sign-ins. No PAT or password is entered here." FontSize="12" />
                <Label Text="The fixed preset uses an own hub, private endpoints, project 001, and your existing Dev subscription. Stage and Prod are future steps." FontSize="12" />
            </VerticalStackLayout>
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <controls:TechnicalLabel Caption="Status Message" Value="{Binding StatusMessage}" FontSize="13" />
            <controls:TechnicalLabel Caption="Warning" Value="{Binding Warning}" TextColor="{DynamicResource Warning}" FontSize="13" />
            <controls:TechnicalLabel Caption="Error Message" Value="{Binding ErrorMessage}" TextColor="{DynamicResource Danger}" FontSize="13" AutomationId="SimpleFactoryError" />

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Factory setup" Style="{StaticResource SectionTitle}" />
                    <VerticalStackLayout Spacing="6" IsEnabled="{Binding CanEdit}">
                        <Label Text="Existing Dev subscription" FontSize="13" />
                        <controls:TechnicalPicker ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                                ItemDisplayBinding="{Binding ., Converter={StaticResource AccountLabels}}"
                                ItemDetailsBinding="{Binding ., Converter={StaticResource AccountLabels}, ConverterParameter=details}"
                                Title="Choose a subscription" FontSize="13"
                                AutomationId="SimpleSubscription" SemanticProperties.Description="Existing Dev subscription" />
                        <controls:TechnicalLabel Caption="Tenant id" Conceal="True" Value="{Binding TenantId, StringFormat='Azure tenant: {0}'}" FontSize="12" />
                        <controls:TechnicalLabel Caption="Azure Account" Value="{Binding AzureAccount, StringFormat='Azure user: {0}'}" FontSize="12" AutomationId="SimpleAzureAccount" />
                        <controls:TechnicalLabel Caption="Github Account" Value="{Binding GithubAccount, StringFormat='GitHub account: {0}'}" FontSize="12" AutomationId="SimpleGithubAccount" />
                        <Label Text="Region" FontSize="13" />
                        <controls:TechnicalPicker ItemsSource="{Binding Regions}" SelectedItem="{Binding Location}" Title="Choose a region" FontSize="13"
                                AutomationId="SimpleRegion" SemanticProperties.Description="Azure region" />
                        <Label Text="Factory prefix" FontSize="13" />
                        <controls:TechnicalEntry Caption="Factory Prefix" Text="{Binding FactoryPrefix}" Placeholder="aif-" FontSize="13"
                               AutomationId="SimplePrefix" SemanticProperties.Description="Factory prefix" />
                        <Label Text="AI Factory template version" FontSize="13" />
                        <controls:TechnicalEntry Caption="Factory version" Text="{Binding FactoryVersion, Mode=TwoWay}"
                               Placeholder="124, 1.25 or main" FontSize="13" AutomationId="SimpleFactoryVersion"
                               SemanticProperties.Description="AI Factory template version; resolved by the API before confirmation" />
                        <Label Text="124 → release/v1.24 · 125 → release/v1.25. Use major.minor for future releases, or main explicitly. Your development branch stays main."
                               FontSize="11" />
                        <Label Text="GitHub repository · owner/name" FontSize="13" />
                        <controls:TechnicalEntry Caption="Github Repository" Text="{Binding GithubRepository}" Placeholder="your-account/your-ai-factory" FontSize="13"
                               AutomationId="SimpleRepository" SemanticProperties.Description="New GitHub repository owner and name" />
                        <Label Text="GitHub repository visibility" FontSize="13" />
                        <controls:TechnicalPicker ItemsSource="{Binding GithubVisibilities}" SelectedItem="{Binding GithubVisibility}"
                               AutomationId="SimpleGithubVisibility" SemanticProperties.Description="GitHub repository visibility, private or public" FontSize="13" />
                        <Label IsVisible="{Binding ShowMoreInfo}" Text="GitHub visibility does not change Azure private networking." FontSize="12" />
                        <Border IsVisible="{Binding IsPublicRepository}" Padding="10" Stroke="{DynamicResource Warning}" StrokeShape="RoundRectangle 8">
                            <Label Text="PUBLIC REPOSITORY: repository code and workflow logs may be visible to everyone. Never commit secrets. Azure private-network settings are unchanged."
                                  TextColor="{DynamicResource Warning}" FontAttributes="Bold" FontSize="13" AutomationId="SimplePublicRepositoryWarning" />
                        </Border>
                    </VerticalStackLayout>
                    <Label IsVisible="{Binding ShowMoreInfo}" Text="No pre-created repository or group is required; existing targets must pass backend safety checks." FontSize="12" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Additional options" VerticalOptions="Center" FontSize="13" FontAttributes="Bold" />
                        <Switch Grid.Column="1" IsToggled="{Binding ShowAdditionalOptions}" AutomationId="SimpleAdditionalOptions"
                                SemanticProperties.Description="Show team and cost center options" />
                    </Grid>
                    <VerticalStackLayout IsVisible="{Binding ShowAdditionalOptions}" IsEnabled="{Binding CanEdit}" Spacing="6">
                        <Label Text="Initial Azure team member email" FontSize="13" />
                        <controls:TechnicalEntry Caption="Team Member Email" Text="{Binding TeamMemberEmail}" Keyboard="Email" FontSize="13"
                               AutomationId="SimpleTeamEmail" SemanticProperties.Description="Initial Azure team member email" />
                        <Label Text="New Entra team group name" FontSize="13" />
                        <controls:TechnicalEntry Caption="Team Group Name" Text="{Binding TeamGroupName}" FontSize="13"
                               AutomationId="SimpleTeamGroup" SemanticProperties.Description="New Entra team group name" />
                        <Label Text="Cost center" FontSize="13" />
                        <controls:TechnicalEntry Caption="Cost Center" Text="{Binding CostCenter}" FontSize="13"
                               AutomationId="SimpleCostCenter" SemanticProperties.Description="Cost center" />
                    </VerticalStackLayout>
                    <controls:TechnicalLabel Caption="Default Name Warning" Value="{Binding DefaultNameWarning}" TextColor="{DynamicResource Warning}" FontSize="12" />
                    <controls:TechnicalLabel Caption="Cost Center" IsVisible="{Binding ShowMoreInfo}" Value="{Binding CostCenter, StringFormat='Cost center: {0}'}" FontSize="12" />
                    <Label IsVisible="{Binding ShowMoreInfo}" Text="AI Factory hub" Style="{StaticResource SectionTitle}" />
                    <controls:TechnicalLabel Caption="Hub Resources" IsVisible="{Binding ShowMoreInfo}" Value="{Binding HubResources}" FontSize="13" AutomationId="SimpleHubResources" />
                    <VerticalStackLayout IsVisible="{Binding RequiresApplicationGatewaySettings}" IsEnabled="{Binding CanEdit}" Spacing="6">
                        <Label Text="Application Gateway settings" FontAttributes="Bold" FontSize="13" />
                        <Label Text="Required for the HTTPS Application Gateway in the backend catalog. This is not the VPN gateway. Missing values will block the creation preview." FontSize="12" />
                        <Label Text="Frontend hostname" FontSize="13" />
                        <controls:TechnicalEntry Caption="App Gateway Hostname" Text="{Binding AppGatewayHostname}" Placeholder="app.example.com" FontSize="13"
                               AutomationId="SimpleAppGatewayHostname" SemanticProperties.Description="Application Gateway frontend hostname" />
                        <Label Text="Backend FQDN" FontSize="13" />
                        <controls:TechnicalEntry Caption="App Gateway Backend Fqdn" Text="{Binding AppGatewayBackendFqdn}" Placeholder="backend.example.com" FontSize="13"
                               AutomationId="SimpleAppGatewayBackendFqdn" SemanticProperties.Description="Application Gateway backend FQDN" />
                        <Label Text="Key Vault certificate secret URI · versionless" FontSize="13" />
                        <controls:TechnicalEntry Caption="App Gateway Certificate Secret Id" Text="{Binding AppGatewayCertificateSecretId}" Placeholder="https://vault.vault.azure.net/secrets/certificate-name" FontSize="13"
                               AutomationId="SimpleAppGatewayCertificateSecretId" SemanticProperties.Description="Versionless Key Vault certificate secret URI, not a secret value" />
                        <Label Text="Enter only the versionless secret URI. Do not paste a certificate, password, private key or secret value. The backend validates certificate access and routing." FontSize="12" />
                    </VerticalStackLayout>
                    <Label IsVisible="{Binding ShowMoreInfo}" Text="AI Factory common" Style="{StaticResource SectionTitle}" />
                    <controls:TechnicalLabel Caption="Common Resources" IsVisible="{Binding ShowMoreInfo}" Value="{Binding CommonResources}" FontSize="13" AutomationId="SimpleCommonResources" />
                    <Label Text="AI Factory project 001" Style="{StaticResource SectionTitle}" />
                    <Label IsVisible="{Binding ShowMoreInfo}" Text="Required resources stay included. Optional resources can be cleared." FontSize="12" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ProjectResources}" IsEnabled="{Binding CanEdit}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanChange}" VerticalOptions="Start"
                                              AutomationId="{Binding Id, StringFormat='SimpleProjectResource_{0}'}"
                                              SemanticProperties.Description="{Binding Label}" />
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <controls:TechnicalLabel Caption="Label" Value="{Binding Label}" FontSize="13" FontAttributes="Bold" />
                                        <controls:TechnicalLabel Caption="Requirement" Value="{Binding Requirement}" FontSize="12" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                    <controls:TechnicalLabel Caption="Resource Selection Warning" Value="{Binding ResourceSelectionWarning}" FontSize="13" TextColor="{DynamicResource Warning}" AutomationId="SimpleResourceSelectionWarning" />
                    <Label Text="Review creation before anything is provisioned" FontSize="13" FontAttributes="Bold" />
                    <Button Text="Create AI Factory" Command="{Binding PrepareCommand}" HorizontalOptions="Start"
                            AutomationId="SimpleCreateFactory" />
                </VerticalStackLayout>
            </Border>

            <controls:TechnicalLabel Caption="Options Warnings" IsVisible="{Binding ShowMoreInfo}" Value="{Binding OptionsWarnings}" TextColor="{DynamicResource Warning}" FontSize="13" />
            <controls:TechnicalLabel Caption="Options Requirements" IsVisible="{Binding ShowMoreInfo}" Value="{Binding OptionsRequirements}" FontSize="13" />
            <Border Style="{StaticResource CardBorder}" IsVisible="{Binding HasPlan}" AutomationId="SimpleFactoryPlan">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Review creation · nothing has started" Style="{StaticResource SectionTitle}" />
                    <controls:TechnicalLabel Caption="Summary" Value="{Binding Plan.Summary}" FontSize="13" />
                    <controls:TechnicalLabel Caption="Template branch" Value="{Binding PlanTemplateBranch, StringFormat='Template branch: {0}'}"
                                             FontSize="13" AutomationId="SimpleTemplateBranch" />
                    <controls:TechnicalLabel Caption="Exact template reference" Value="{Binding PlanTemplateRef}" Conceal="True"
                                             FontSize="12" AutomationId="SimpleTemplateRef" />
                    <Label Text="Your development branch remains main; the template version is independent." FontSize="12" />
                    <Border IsVisible="{Binding HasBlockers}" Padding="12" Stroke="{DynamicResource Danger}" StrokeShape="RoundRectangle 10">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Cannot create yet" FontAttributes="Bold" TextColor="{DynamicResource Danger}" />
                            <controls:TechnicalLabel Caption="Plan Blockers" Value="{Binding PlanBlockers}" TextColor="{DynamicResource Danger}" FontSize="13" AutomationId="SimplePlanBlockers" />
                            <Label Text="Resolve the blockers, then choose Create AI Factory to review again. If source changes are unpublished, commit and push them yourself; this app never publishes source." FontSize="12" />
                        </VerticalStackLayout>
                    </Border>
                    <VerticalStackLayout IsVisible="{Binding ShowMoreInfo}" Spacing="6">
                    <Label Text="Where and who" FontAttributes="Bold" />
                    <controls:TechnicalLabel Caption="Plan Scope" Value="{Binding PlanScope}" FontSize="13" AutomationId="SimplePlanScope" />
                    <Label IsVisible="{Binding IsPublicRepository}" Text="PUBLIC REPOSITORY: code and workflow logs may be public. Azure private configuration is unchanged. Confirm only if this visibility is intended."
                           TextColor="{DynamicResource Warning}" FontAttributes="Bold" FontSize="13" />
                    <Label Text="What will change" FontAttributes="Bold" />
                    <controls:TechnicalLabel Caption="Plan Effects" Value="{Binding PlanEffects}" FontSize="13" AutomationId="SimplePlanEffects" />
                    <Label Text="AI Factory hub" FontAttributes="Bold" />
                    <controls:TechnicalLabel Caption="Plan Hub Resources" Value="{Binding PlanHubResources}" FontSize="13" />
                    <Label Text="AI Factory common" FontAttributes="Bold" />
                    <controls:TechnicalLabel Caption="Plan Common Resources" Value="{Binding PlanCommonResources}" FontSize="13" />
                    <Label Text="AI Factory project 001" FontAttributes="Bold" />
                    <controls:TechnicalLabel Caption="Plan Project Resources" Value="{Binding PlanProjectResources}" FontSize="13" />
                    <Label Text="Permissions, costs and prerequisites" FontAttributes="Bold" />
                    <controls:TechnicalLabel Caption="Plan Requirements" Value="{Binding PlanRequirements}" FontSize="13" />
                    </VerticalStackLayout>
                    <controls:TechnicalLabel Caption="Plan Warnings" Value="{Binding PlanWarnings}" TextColor="{DynamicResource Warning}" FontSize="13" />
                    <Label Text="Creation can take a long time and incur Azure costs." FontSize="12" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Exact command and all explicit non-secret environment values" FontSize="13" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding ShowTechnicalDetails}"
                                SemanticProperties.Description="Show exact script, command and environment values" />
                    </Grid>
                    <VerticalStackLayout IsVisible="{Binding ShowTechnicalDetails}" Spacing="8">
                        <controls:TechnicalLabel Caption="Script details" Conceal="True" Value="{Binding Plan.ScriptPath, StringFormat='Fixed script: {0}'}" FontSize="12" />
                        <controls:TechnicalLabel Caption="Exact command" Conceal="True" Value="{Binding Plan.Command}" FontSize="12" AutomationId="SimplePlanCommand" />
                        <controls:TechnicalLabel Caption="Plan Environment" Value="{Binding PlanEnvironment}" FontSize="12" AutomationId="SimplePlanEnvironment" />
                    </VerticalStackLayout>
                    <controls:TechnicalLabel Caption="Plan Expiry" Value="{Binding PlanExpiry}" TextColor="{DynamicResource Warning}" FontSize="12" />
                    <FlexLayout Direction="Row" Wrap="Wrap">
                        <Button Text="Confirm and create" Command="{Binding ConfirmCommand}" Margin="0,0,10,4" AutomationId="SimpleConfirmCreate" />
                        <Button Text="Cancel preview" Command="{Binding DismissPlanCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,0,4" />
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>
            <Border Style="{StaticResource CardBorder}" IsVisible="{Binding HasJob}" AutomationId="SimpleFactoryJob">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Creation progress" Style="{StaticResource SectionTitle}" />
                    <controls:TechnicalLabel Caption="Job id" Value="{Binding JobId, StringFormat='Job: {0}'}" FontSize="12" />
                    <controls:TechnicalLabel Caption="Status" Value="{Binding Job.Status, StringFormat='Status: {0}'}" FontAttributes="Bold" FontSize="13" />
                    <controls:TechnicalLabel Caption="Stage" Value="{Binding Job.Stage, StringFormat='Stage: {0}'}" FontSize="13" />
                    <controls:TechnicalLabel Caption="Message" Value="{Binding Job.Message}" FontSize="13" />
                    <controls:TechnicalLabel Caption="Job Exit" Value="{Binding JobExit}" FontSize="12" />
                    <controls:TechnicalLabel Caption="Updated At" Value="{Binding Job.UpdatedAt, StringFormat='Last updated: {0}'}" FontSize="12" />
                    <Label IsVisible="{Binding ShowMoreInfo}" Text="Leaving this page pauses monitoring, not deployment. Never blindly rerun a partial deployment." FontSize="12" />
                    <Label IsVisible="{Binding JobNeedsAttention}" Text="Creation did not complete successfully. Inspect the events and resources already created before attempting another creation."
                           TextColor="{DynamicResource Danger}" FontSize="13" />
                    <controls:TechnicalLabel Caption="Monitoring Error" Value="{Binding MonitoringError}" TextColor="{DynamicResource Danger}" FontSize="13" />
                    <VerticalStackLayout IsVisible="{Binding ShowMoreInfo}" Spacing="4">
                        <controls:TechnicalLabel Caption="Job Owner" Value="{Binding JobOwner}" FontSize="12" />
                        <controls:TechnicalLabel Caption="Job Events" Value="{Binding JobEvents}" FontSize="12" AutomationId="SimpleJobEvents" />
                        <controls:TechnicalLabel Caption="Repository Url" Value="{Binding Job.RepositoryUrl}" FontSize="12" />
                    </VerticalStackLayout>
                    <FlexLayout Direction="Row" Wrap="Wrap">
                        <Button Text="Refresh status" Command="{Binding RefreshJobCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,4" />
                        <Button Text="Open GitHub repository" Clicked="OnOpenRepositoryClicked" IsVisible="{Binding CanOpenRepository}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,0,4" />
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
