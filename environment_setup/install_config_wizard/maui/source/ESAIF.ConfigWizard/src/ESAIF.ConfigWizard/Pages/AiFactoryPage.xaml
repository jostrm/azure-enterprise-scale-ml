<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ESAIF.ConfigWizard.Pages.AiFactoryPage"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ESAIF.ConfigWizard.Controls"
    Title="AI Factory"
    Shell.NavBarIsVisible="False">
    <ContentPage.Resources>
        <Style x:Key="ProjectCard" TargetType="controls:ProjectEnvironmentCardView">
            <Setter Property="SelectCommand" Value="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelectProjectCommand}" />
            <Setter Property="OpenTerminalCommand" Value="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenTerminalCommand}" />
            <Setter Property="DeployCommand" Value="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DeployCommand}" />
            <Setter Property="UpdateCommand" Value="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.UpdateCommand}" />
            <Setter Property="ReviewOutcomeCommand" Value="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ReviewOutcomeCommand}" />
            <Setter Property="ConfigureDataOpsCommand" Value="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ConfigureDataOpsCommand}" />
            <Setter Property="ConfigureMLOpsCommand" Value="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ConfigureMLOpsCommand}" />
            <Setter Property="ConfigureRagCommand" Value="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ConfigureRagCommand}" />
            <Setter Property="ConfigureFineTuningCommand" Value="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.ConfigureFineTuningCommand}" />
        </Style>
    </ContentPage.Resources>

    <Grid Padding="18" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
        <controls:AppHeader
            Grid.Row="0"
            Title="AI Factory environments"
            Subtitle="Plan and deploy the next environment, or update an existing project. Patch is optional."
            TrailingText="{Binding SourceLabel}" />
        <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
            <Border
                Padding="11,6"
                BackgroundColor="{DynamicResource SurfaceSelected}"
                Stroke="{DynamicResource Primary}"
                StrokeShape="RoundRectangle 12">
                <controls:TechnicalLabel Caption="Source Label" Value="{Binding SourceLabel}" FontAttributes="Bold" TextColor="{DynamicResource PrimaryStrong}" />
            </Border>
            <controls:TechnicalLabel Caption="Status Message" Grid.Column="1" Value="{Binding StatusMessage}" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
            <Button Grid.Column="2" Text="Reload drafts" Command="{Binding RefreshDraftsCommand}"
                    Style="{StaticResource SecondaryButton}" AutomationId="ReloadDeploymentDrafts" />
        </Grid>
        <VerticalStackLayout Grid.Row="2" Spacing="8" IsVisible="{Binding IsMissingFolder}">
            <Border IsVisible="{Binding IsMissingFolder}" Style="{StaticResource CardBorder}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <controls:TechnicalLabel Caption="Missing Folder Message" Value="{Binding MissingFolderMessage}" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Open Configuration wizard" Command="{Binding OpenWizardCommand}" />
                </Grid>
            </Border>
        </VerticalStackLayout>
        <ScrollView x:Name="BoardScroll" Grid.Row="3" Orientation="Both" IsVisible="{Binding HasOverview}">
            <VerticalStackLayout MinimumWidthRequest="990" Spacing="8">
                <controls:TechnicalLabel Caption="Deployment error" Value="{Binding ErrorMessage}" TextColor="{DynamicResource Danger}"
                                         AutomationId="ProjectDeploymentError" />
                <controls:TechnicalLabel Caption="Factory template readiness" Value="{Binding FactoryVersionWarnings}"
                                         TextColor="{DynamicResource Warning}" AutomationId="FactoryVersionWarnings" />
                <Border IsVisible="{Binding HasDeploymentPlan}" Style="{StaticResource CardBorder}"
                        AutomationId="ProjectDeploymentReview">
                    <VerticalStackLayout Spacing="8">
                        <controls:TechnicalLabel Caption="Deployment Review Title" Value="{Binding DeploymentReviewTitle}" FontSize="20" FontAttributes="Bold" />
                        <controls:TechnicalLabel Caption="Summary" Value="{Binding DeploymentPlan.Summary}" />
                        <controls:TechnicalLabel Caption="Template branch" Value="{Binding DeploymentTemplateBranch, StringFormat='Template branch: {0}'}"
                                                 AutomationId="ProjectDeploymentTemplateBranch" />
                        <controls:TechnicalLabel Caption="Exact template reference" Value="{Binding DeploymentTemplateRef}" Conceal="True"
                                                 AutomationId="ProjectDeploymentTemplateRef" />
                        <Label Text="Your development branch stays main. With Patch off, installed code is preserved; changing version requires a prior factory upgrade or enabling Patch." FontSize="12" />
                        <controls:TechnicalLabel Caption="Deployment Scope" Value="{Binding DeploymentScope, StringFormat='Factory: {0}'}" Style="{StaticResource MutedLabel}" />
                        <controls:TechnicalLabel Caption="Working directory" Conceal="True" Value="{Binding DeploymentPlan.WorkingDirectory, StringFormat='Working directory: {0}'}" Style="{StaticResource MutedLabel}" />
                        <Label Text="Exact command" FontAttributes="Bold" />
                        <controls:TechnicalLabel Caption="Exact command" Conceal="True" Value="{Binding DeploymentPlan.Command}" FontFamily="Consolas" FontSize="12" />
                        <controls:TechnicalLabel Caption="Deployment Effects" Value="{Binding DeploymentEffects}" />
                        <controls:TechnicalLabel Caption="Deployment Warnings" Value="{Binding DeploymentWarnings}" />
                        <controls:TechnicalLabel Caption="Deployment Blockers" Value="{Binding DeploymentBlockers}" TextColor="#F8A75A" />
                        <controls:TechnicalLabel Caption="Expires At" Value="{Binding DeploymentPlan.ExpiresAt, StringFormat='Confirmation expires: {0}'}" Style="{StaticResource MutedLabel}" />
                        <controls:TechnicalLabel Caption="Deployment Notice" Value="{Binding DeploymentNotice}" />
                        <HorizontalStackLayout Spacing="10">
                            <controls:TechnicalButton Value="{Binding ConfirmDeploymentText}" Command="{Binding ConfirmDeploymentCommand}"
                                    BackgroundColor="#1675D1" TextColor="White" AutomationId="ConfirmProjectDeployment" />
                            <Button Text="Cancel" Command="{Binding DismissDeploymentCommand}" Style="{StaticResource SecondaryButton}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Border Padding="10,7" BackgroundColor="{DynamicResource SurfaceSelected}" StrokeThickness="0" StrokeShape="RoundRectangle 10">
                        <controls:TechnicalLabel Caption="Dev Count" Value="{Binding DevCount, StringFormat='Dev ({0})'}" FontSize="15" FontAttributes="Bold" />
                    </Border>
                    <Border Grid.Column="1" Padding="10,7" BackgroundColor="{DynamicResource SurfaceSelected}" StrokeThickness="0" StrokeShape="RoundRectangle 10">
                        <controls:TechnicalLabel Caption="Stage Header" Value="{Binding StageHeader}" FontSize="15" FontAttributes="Bold" />
                    </Border>
                    <Border Grid.Column="2" Padding="10,7" BackgroundColor="{DynamicResource SurfaceSelected}" StrokeThickness="0" StrokeShape="RoundRectangle 10">
                        <controls:TechnicalLabel Caption="Prod Header" Value="{Binding ProdHeader}" FontSize="15" FontAttributes="Bold" />
                    </Border>
                </Grid>
                <Label IsVisible="{Binding IsEmpty}" Text="No deployed projects or saved drafts are available. Refresh Azure to collect current evidence."
                       Margin="12" FontSize="13" TextColor="{DynamicResource Muted}" />
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding ProjectRows}" Spacing="8">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                <controls:ProjectEnvironmentCardView BindingContext="{Binding Dev}" Style="{StaticResource ProjectCard}" />
                                <controls:ProjectEnvironmentCardView Grid.Column="1" BindingContext="{Binding Stage}" Style="{StaticResource ProjectCard}" />
                                <controls:ProjectEnvironmentCardView Grid.Column="2" BindingContext="{Binding Prod}" Style="{StaticResource ProjectCard}" />
                            </Grid>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
