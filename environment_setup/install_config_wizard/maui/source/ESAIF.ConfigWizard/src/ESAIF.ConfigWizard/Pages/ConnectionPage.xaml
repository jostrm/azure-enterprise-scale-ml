<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ESAIF.ConfigWizard.Pages.ConnectionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ESAIF.ConfigWizard.Controls"
    Title="Connection"
    Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14" MaximumWidthRequest="900">
            <controls:AppHeader
                Title="Python API connection"
                Subtitle="Bundled on Windows · authenticated HTTPS companion on mobile" />
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Endpoint" Style="{StaticResource SectionTitle}" />
                    <controls:TechnicalLabel Caption="Connection Mode Description"
                        Value="{Binding ConnectionModeDescription}"
                        Style="{StaticResource MutedLabel}" />
                    <VerticalStackLayout IsVisible="{Binding NeedsManualConnection}" Spacing="8">
                    <Label Text="API base address" FontAttributes="Bold" />
                    <Border Style="{StaticResource InputBorder}">
                        <controls:TechnicalEntry Caption="Base Address" Text="{Binding BaseAddress}" Keyboard="Url" />
                    </Border>
                    <Label Text="API key" FontAttributes="Bold" />
                    <Border Style="{StaticResource InputBorder}">
                        <Entry Text="{Binding ApiKey}" IsPassword="True" />
                    </Border>
                    <Label
                        Text="The key is never stored in source code. Platform secure storage protects it on this device."
                        Style="{StaticResource MutedLabel}" />
                    </VerticalStackLayout>
                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                        <Button
                            x:Name="ConnectButton"
                            Text="Connect &amp; open wizard"
                            Clicked="OnConnectClicked" />
                        <Button
                            Grid.Column="1"
                            Text="Open Swagger"
                            Clicked="OnOpenSwaggerClicked"
                            Style="{StaticResource SecondaryButton}" />
                        <ActivityIndicator
                            Grid.Column="2"
                            HorizontalOptions="End"
                            IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}" />
                    </Grid>
                    <Border
                        Padding="12"
                        BackgroundColor="{DynamicResource SurfaceMuted}"
                        Stroke="{DynamicResource Border}"
                        StrokeShape="RoundRectangle 10">
                        <Border.Triggers>
                            <DataTrigger
                                TargetType="Border"
                                Binding="{Binding IsConnected}"
                                Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource SuccessSurface}" />
                                <Setter Property="Stroke" Value="{DynamicResource Success}" />
                            </DataTrigger>
                        </Border.Triggers>
                        <controls:TechnicalLabel Caption="Status Message" Value="{Binding StatusMessage}" TextColor="{DynamicResource Text}" />
                    </Border>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
