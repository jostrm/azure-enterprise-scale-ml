<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="ESAIF.ConfigWizard.Pages.OperationConfigPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ESAIF.ConfigWizard.Controls"
    Title="{Binding Title}"
    Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14" MaximumWidthRequest="1200">
            <controls:AppHeader
                Title="{Binding Title}"
                Subtitle="{Binding Subtitle}"
                TrailingText="{Binding SourceLabel}" />
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                <Button Text="Back" Command="{Binding BackCommand}" Style="{StaticResource SecondaryButton}" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                    <controls:TechnicalLabel Caption="Status Message" Value="{Binding StatusMessage}" Style="{StaticResource MutedLabel}" />
                    <controls:TechnicalLabel Caption="Saved Status" Value="{Binding SavedStatus}" Style="{StaticResource MutedLabel}" />
                </VerticalStackLayout>
                <Button Grid.Column="2" Text="Save" Command="{Binding SaveCommand}" />
            </Grid>
            <FlexLayout
                Direction="Row"
                Wrap="Wrap"
                AlignItems="Start"
                BindableLayout.ItemsSource="{Binding Fields}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <controls:OperationConfigFieldCard WidthRequest="420" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
            <VerticalStackLayout IsVisible="{Binding HasGuidance}" Spacing="10">
                <Label Text="Guidance" Style="{StaticResource SectionTitle}" />
                <FlexLayout
                    Direction="Row"
                    Wrap="Wrap"
                    AlignItems="Stretch"
                    BindableLayout.ItemsSource="{Binding Guidance}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border WidthRequest="350" Margin="0,0,12,12" Style="{StaticResource CardBorder}">
                                <VerticalStackLayout Spacing="6">
                                    <controls:TechnicalLabel Caption="Title" Value="{Binding Title}" FontAttributes="Bold" TextColor="{DynamicResource PrimaryStrong}" />
                                    <controls:TechnicalLabel Caption="Description" Value="{Binding Description}" Style="{StaticResource MutedLabel}" LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
