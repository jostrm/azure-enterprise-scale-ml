<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="ESAIF.ConfigWizard.Controls.AzureRefreshFooter"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ESAIF.ConfigWizard.Controls">
    <Border BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Border}"
            Padding="18,10" StrokeShape="RoundRectangle 0">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="12">
            <controls:StatusLight LightColor="{Binding LightColor}" IsPulsing="{Binding IsRunning}"
                                  SemanticProperties.Description="{Binding StatusLabel}" />
            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                <controls:TechnicalLabel Caption="Status Label" Value="{Binding StatusLabel}" FontAttributes="Bold" FontSize="12"
                       AutomationId="GlobalAzureRefreshStatus" />
                <controls:TechnicalLabel Caption="Message" Value="{Binding Message}" FontSize="11" TextColor="{DynamicResource Muted}"
                       LineBreakMode="TailTruncation" ToolTipProperties.Text="{Binding Message}" />
                <controls:TechnicalLabel Caption="Completed Label" Value="{Binding CompletedLabel}" FontSize="10" TextColor="{DynamicResource Muted}" />
            </VerticalStackLayout>
            <Button x:Name="WarningsButton" Grid.Column="2" Text="!" Clicked="OnWarningsClicked"
                    IsEnabled="{Binding HasMessages}" AutomationId="ReplayWarningToasts"
                    WidthRequest="44" HeightRequest="44" FontAttributes="Bold" FontSize="20"
                    TextColor="{DynamicResource Warning}" Style="{StaticResource GhostButton}" VerticalOptions="Center"
                    SemanticProperties.Description="Show warnings and errors"
                    ToolTipProperties.Text="Show warnings and errors again. Reopened messages stay until dismissed." />
            <Button Grid.Column="3" Text="Refresh Azure" Command="{Binding RefreshCommand}"
                    AutomationId="GlobalRefreshAzure" Style="{StaticResource FactoryActionButton}"
                    VerticalOptions="Center" />
            <Button Grid.Column="4" Text="Login to Azure" Clicked="OnLoginClicked"
                    IsVisible="{Binding NeedsLogin}" AutomationId="FooterAzureLogin"
                    Style="{StaticResource FactoryActionButton}" VerticalOptions="Center" />
        </Grid>
    </Border>
</ContentView>
