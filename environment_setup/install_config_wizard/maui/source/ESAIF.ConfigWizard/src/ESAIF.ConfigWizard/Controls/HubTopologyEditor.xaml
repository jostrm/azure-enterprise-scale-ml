<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="ESAIF.ConfigWizard.Controls.HubTopologyEditor"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ESAIF.ConfigWizard.Controls">
    <VerticalStackLayout Spacing="8">
        <RadioButton x:Name="StandaloneRadio" Content="Standalone AI Factory"
                     IsEnabled="{Binding CanSelectStandalone}" AutomationId="HubStandalone" />
        <RadioButton x:Name="OwnHubRadio" Content="Standalone with own Hub"
                     AutomationId="HubOwn" />
        <RadioButton x:Name="ExternalHubRadio" Content="External Hub connected"
                     AutomationId="HubExternal" />
        <BoxView HeightRequest="1" Color="{DynamicResource Border}" Margin="0,4" />
        <Label Text="Resulting flag values (read-only)" FontAttributes="Bold" />
        <controls:TechnicalLabel Caption="Dns Policy" Value="{Binding DnsPolicy, StringFormat='centralDnsZoneByPolicyInHub: {0}'}"
               FontSize="12" AutomationId="HubDnsPolicyResult" />
        <controls:TechnicalLabel Caption="Own Hub Enabled" Value="{Binding OwnHubEnabled, StringFormat='enableAIFactoryHub: {0}'}"
               FontSize="12" AutomationId="HubOwnEnabledResult" />
        <controls:TechnicalLabel Caption="Guidance" Value="{Binding Guidance}" FontSize="12" LineBreakMode="WordWrap"
               TextColor="{DynamicResource Muted}" AutomationId="HubTopologyGuidance" />
    </VerticalStackLayout>
</ContentView>
