<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="ESAIF.ConfigWizard.Controls.TicketConnectionsView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ESAIF.ConfigWizard.Controls">
    <ScrollView>
        <VerticalStackLayout Padding="24,0,24,24" Spacing="12" MaximumWidthRequest="1250">
            <Label Text="Per-user Jira and ServiceNow profiles. Azure sign-in is required." FontSize="13" />
            <Label Text="Saving and listing profiles do not contact Jira or ServiceNow. Connections are NOT tested. Sync is manual from the Tickets tab, after preview and explicit confirmation; there is no live background synchronization." FontSize="13" />
            <FlexLayout Direction="Row" Wrap="Wrap" IsEnabled="{Binding IsNotBusy}">
                <Button Text="Reload my profiles" Command="{Binding ReloadCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,4" />
                <Button Text="New profile" Command="{Binding NewCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,10,4" />
                <Button Text="Back to tickets" Command="{Binding OpenTicketsCommand}" Style="{StaticResource SecondaryButton}" />
            </FlexLayout>
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <controls:TechnicalLabel Caption="Status Message" Value="{Binding StatusMessage}" FontSize="13" />
            <controls:TechnicalLabel Caption="Warning" Value="{Binding Warning}" FontSize="13" TextColor="{DynamicResource Warning}" />
            <controls:TechnicalLabel Caption="Error Message" Value="{Binding ErrorMessage}" FontSize="13" TextColor="{DynamicResource Danger}" AutomationId="TicketConnectionsError" />
            <Label Text="No profiles loaded. Sign in to Azure from the menu, Reload, or create a profile below." IsVisible="{Binding IsEmpty}" FontSize="13" />
            <Border Style="{StaticResource CardBorder}" IsEnabled="{Binding IsNotBusy}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Choose an existing profile to edit, or New profile" FontSize="13" />
                    <controls:TechnicalPicker Title="My connector profiles" ItemsSource="{Binding Connections}" SelectedItem="{Binding SelectedConnection}"
                            ItemDisplayBinding="{Binding Name}" FontSize="13" />
                    <Label Text="Profile name" FontSize="13" />
                    <controls:TechnicalEntry Caption="Name" Text="{Binding Name}" Placeholder="My support queue" FontSize="13" />
                    <Label Text="Provider" FontSize="13" />
                    <controls:TechnicalPicker Title="Jira / ServiceNow" ItemsSource="{Binding Providers}" SelectedItem="{Binding Provider}" FontSize="13" />
                    <Label Text="Base URL (HTTPS, no credential in URL)" FontSize="13" />
                    <controls:TechnicalEntry Caption="Base Url" Text="{Binding BaseUrl}" Placeholder="https://your-organization.atlassian.net" Keyboard="Url" FontSize="13" />
                    <Label Text="Project key (required for Jira)" FontSize="13" />
                    <controls:TechnicalEntry Caption="Project Key" Text="{Binding ProjectKey}" Placeholder="OPS" FontSize="13" />
                    <Label Text="Username (if required by your connector)" FontSize="13" />
                    <controls:TechnicalEntry Caption="Username" Text="{Binding Username}" Placeholder="Connector account name / email" FontSize="13" />
                    <Label Text="Credential environment variable NAME — never the secret" FontSize="13" FontAttributes="Bold" />
                    <controls:TechnicalEntry Caption="Credential Env" Text="{Binding CredentialEnv}" Placeholder="JIRA_API_TOKEN or SERVICENOW_PASSWORD" FontSize="13" AutomationId="TicketCredentialEnvironment" />
                    <Label Text="Ask the Python API host administrator to set that environment variable to the credential and restart the API if required. The secret is not entered or stored in this UI. An unset variable is not a successful connection; saving only persists the profile, not a test result." FontSize="13" />
                    <Button Text="Save profile — no external send" Command="{Binding SaveCommand}" HorizontalOptions="Start" AutomationId="SaveTicketConnection" />
                </VerticalStackLayout>
            </Border>
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Connections}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}">
                            <VerticalStackLayout Spacing="5">
                                <controls:TechnicalLabel Caption="Name" Value="{Binding Name}" FontSize="13" FontAttributes="Bold" />
                                <controls:TechnicalLabel Caption="Provider" Value="{Binding Provider, StringFormat='Provider: {0}'}" FontSize="13" />
                                <controls:TechnicalLabel Caption="Base Url" Value="{Binding BaseUrl, StringFormat='Base URL: {0}'}" FontSize="13" />
                                <controls:TechnicalLabel Caption="Project Key" Value="{Binding ProjectKey, TargetNullValue='Not specified', StringFormat='Project key: {0}'}" FontSize="13" />
                                <controls:TechnicalLabel Caption="Username" Value="{Binding Username, TargetNullValue='Not specified', StringFormat='Username: {0}'}" FontSize="13" />
                                <controls:TechnicalLabel Caption="Credential Env" Value="{Binding CredentialEnv, StringFormat='Python-host credential environment: {0}'}" FontSize="13" />
                                <Label Text="Not tested · manual sync only" FontSize="13" TextColor="{DynamicResource Warning}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
