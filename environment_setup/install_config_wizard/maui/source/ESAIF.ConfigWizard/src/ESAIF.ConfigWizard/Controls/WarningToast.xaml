<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="ESAIF.ConfigWizard.Controls.WarningToast"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ESAIF.ConfigWizard.Controls"
    HorizontalOptions="End" VerticalOptions="End"
    MaximumWidthRequest="680" Margin="20" ZIndex="20">
    <Border x:Name="ToastPanel" IsVisible="{Binding IsVisible}" Opacity="{Binding Opacity}"
            AutomationId="WarningToastPanel" Padding="16" StrokeShape="RoundRectangle 14"
            BackgroundColor="{DynamicResource Surface}" Stroke="{DynamicResource Warning}">
        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="10" ColumnSpacing="12">
            <controls:TechnicalLabel Caption="Title" x:Name="ToastTitle" Value="{Binding Title}" FontAttributes="Bold"
                   FontSize="16" TextColor="{DynamicResource Warning}" VerticalOptions="Center" />
            <Button x:Name="CloseButton" Grid.Column="1" Text="X" Clicked="OnCloseClicked"
                    AutomationId="DismissWarningToast" Style="{StaticResource GhostButton}"
                    WidthRequest="44" HeightRequest="44"
                    SemanticProperties.Description="Dismiss warnings and errors"
                    ToolTipProperties.Text="Dismiss. Messages remain available using ! in the footer." />
            <ScrollView Grid.Row="1" Grid.ColumnSpan="2" MaximumHeightRequest="160">
                <controls:TechnicalLabel Caption="Message" Value="{Binding Message}" LineBreakMode="WordWrap"
                       AutomationId="WarningToastMessage" FontSize="13" />
            </ScrollView>
            <controls:TechnicalLabel Caption="Hint" Grid.Row="2" Value="{Binding Hint}" FontSize="11" TextColor="{DynamicResource Muted}"
                   VerticalOptions="Center" />
            <Button x:Name="DetailsButton" Grid.Row="2" Grid.Column="1" Text="View / copy"
                    Clicked="OnDetailsClicked" AutomationId="WarningToastDetails"
                    Style="{StaticResource GhostButton}" />
        </Grid>
    </Border>
</ContentView>
