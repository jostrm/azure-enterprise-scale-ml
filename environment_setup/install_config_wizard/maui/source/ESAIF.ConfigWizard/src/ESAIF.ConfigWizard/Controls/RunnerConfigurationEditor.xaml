<?xml version="1.0" encoding="utf-8" ?>
<ContentView x:Class="ESAIF.ConfigWizard.Controls.RunnerConfigurationEditor"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:ESAIF.ConfigWizard.Controls">
    <VerticalStackLayout Spacing="10">
        <RadioButton x:Name="HostedRadio" Content="{Binding HostedLabel}" AutomationId="RunnerHosted" />
        <RadioButton x:Name="SelfHostedRadio" Content="{Binding SelfHostedLabel}" AutomationId="RunnerSelfHosted" />
        <controls:TechnicalLabel Caption="Flag Value" Value="{Binding FlagValue, StringFormat='useSelfHostedBuildAgent: {0}'}"
               FontSize="12" AutomationId="RunnerHostingResult" />
        <controls:TechnicalLabel Caption="Guidance" Value="{Binding Guidance}" Style="{StaticResource MutedLabel}" LineBreakMode="WordWrap" />
        <controls:TechnicalLabel Caption="Vm Name Reference" Value="{Binding VmNameReference}" IsVisible="{Binding ShowVmNameReference}"
               FontSize="12" AutomationId="RunnerVmNameReference" />
        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Details}">
            <BindableLayout.ItemTemplate>
                <DataTemplate>
                    <controls:ConfigFieldCard />
                </DataTemplate>
            </BindableLayout.ItemTemplate>
        </VerticalStackLayout>
        <Label Text="Configuration only. Choosing self-hosted does not create or start a VM, register a runner, or change a running pipeline."
               Style="{StaticResource MutedLabel}" />
    </VerticalStackLayout>
</ContentView>
