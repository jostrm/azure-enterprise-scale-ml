union isfuzzy=true (datatable(Name:string, TimeGenerated:datetime, Properties:dynamic)[]), AppEvents
| where Name == "aifactory.agent.observation"
| extend observation = parse_json(tostring(Properties.observation))
| where tostring(observation.source) == "live" and tostring(observation.schema) == "aifactory.agent-observations/v1"
| extend AiFactory=tostring(observation.scope.aiFactory), Scaleset=tostring(observation.scope.scaleset), Project=tostring(observation.scope.project), Environment=tostring(observation.scope.environment), Agent=tostring(observation.scope.agent)
| extend Kind=tostring(observation.kind), DataSource=tostring(observation.dataSource), Evidence=tostring(observation.evidence.reference), ObservationId=tostring(observation.id)
| extend EvidencePresent=isnotempty(trim(@"\s+", Evidence))
| extend MetadataValidated=gettype(observation.metadata_validated) == "bool" and tobool(observation.metadata_validated) == true
