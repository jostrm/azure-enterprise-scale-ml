// "Deploy to Azure" entry point for the AI Factory v1.25 Simple Mode full bootstrap (private, topology s).
// Each stage is a linked deployment (templateLink.relativePath) of a template compiled with Bicep 0.37.4 and
// published beside this file; inlining them would exceed ARM's 4 MB template limit.
// Stage parameter values are generated by portal/generate_portal.py from the Simple Mode preset,
// variables.json and the GitHub workflows. This file only fills deployment-time tokens and wires outputs.
targetScope = 'subscription'

@description('AI Factory region. Limited to regions supported by the v1.25 CLI and Bastion Developer.')
@allowed([
  'eastus2'
  'germanywestcentral'
  'northeurope'
  'swedencentral'
  'uksouth'
  'westeurope'
])
param location string

@description('Naming prefix: 2-16 lowercase letters, digits or hyphens.')
@minLength(2)
@maxLength(17)
param prefix string

@description('Scale set number, 001-999.')
@minLength(3)
@maxLength(3)
param scalesetNumber string = '001'

@description('CostCenter tag value.')
param costCenter string = '123456'

@description('Object ID of an existing Entra security group for the project team. The deployment never writes to Entra ID.')
param teamGroupObjectId string

@description('Display name of that group (tags and RBAC descriptions only).')
param teamGroupName string

@description('Technical contact e-mail (technicalAdminsEmail).')
param teamMemberEmail string

@description('AI Search region. Empty or same-as-factory-region means the AI Factory region. No automatic capacity retry.')
param aiSearchLocation string = ''

@description('Optional workspace-based project Application Insights.')
param enableApplicationInsights bool = true

@description('Bastion Developer on the common VNet (free, no admin VM).')
param enableBastion bool = true

@description('Assign the Deploy-Private-DNS-Zones initiative to this subscription.')
param enablePrivateDnsPolicy bool = true

@description('Billable point-to-site VPN Gateway VpnGw1AZ with Entra authentication (30-45 minutes).')
param enableVpnGateway bool = false

@description('VPN client address pool; must not overlap 172.16.0.0/20.')
param vpnClientCidr string = '172.31.240.0/24'

@description('Billable private Application Gateway WAF_v2. Requires the four inputs below.')
param enableApplicationGateway bool = false

@description('Gateway HTTPS frontend hostname covered by the certificate.')
param appGatewayHostname string = ''

@description('Private HTTPS backend FQDN reachable from the VNet.')
param appGatewayBackendFqdn string = ''

@description('Versionless https://<vault>.vault.azure.net/secrets/<name> URI of an exportable PFX certificate (an identifier, not a secret).')
#disable-next-line secure-secrets-in-params
param appGatewayCertificateSecretId string = ''

@description('Resource ID of the Key Vault holding that certificate.')
param appGatewayCertificateVaultId string = ''

var plan = loadJsonContent('generated/stage-parameters.json')
var stages = plan.stages
var prefixNormalized = endsWith(prefix, '-') ? prefix : '${prefix}-'
var prefixBare = substring(prefixNormalized, 0, length(prefixNormalized) - 1)
var locationShort = plan.locationShort[location]
var commonResourceGroup = '${prefixNormalized}esml-common-${locationShort}-dev-${scalesetNumber}'
var bootstrapResourceGroup = 'rg-${prefixBare}-bootstrap-${locationShort}-${scalesetNumber}'
var vnetCidr = plan.network.vnetCidr
var subnets = plan.network.subnets
var tokens = {
  location: location
  locationShort: locationShort
  prefix: prefixNormalized
  prefixBare: prefixBare
  scalesetNumber: scalesetNumber
  subscriptionId: subscription().subscriptionId
  tenantId: tenant().tenantId
  teamGroupObjectId: teamGroupObjectId
  teamGroupName: teamGroupName
  teamMemberEmail: teamMemberEmail
  costCenter: costCenter
  seedingKeyVaultName: take('kv${replace(prefixNormalized, '-', '')}${locationShort}${scalesetNumber}', 24)
  bootstrapResourceGroup: bootstrapResourceGroup
  commonResourceGroup: commonResourceGroup
  searchLocation: empty(aiSearchLocation) || aiSearchLocation == 'same-as-factory-region' ? location : aiSearchLocation
  deploymentRandom: take(uniqueString(subscription().id, prefixNormalized, scalesetNumber, location), 10)
}

func fill(text string, t object) string =>
  replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(replace(
    text,
    '__P_location__', t.location),
    '__P_locationShort__', t.locationShort),
    '__P_prefix__', t.prefix),
    '__P_prefixBare__', t.prefixBare),
    '__P_scalesetNumber__', t.scalesetNumber),
    '__P_subscriptionId__', t.subscriptionId),
    '__P_tenantId__', t.tenantId),
    '__P_teamGroupObjectId__', t.teamGroupObjectId),
    '__P_teamGroupName__', t.teamGroupName),
    '__P_teamMemberEmail__', t.teamMemberEmail),
    '__P_costCenter__', t.costCenter),
    '__P_seedingKeyVaultName__', t.seedingKeyVaultName),
    '__P_bootstrapResourceGroup__', t.bootstrapResourceGroup),
    '__P_commonResourceGroup__', t.commonResourceGroup),
    '__P_searchLocation__', t.searchLocation),
    '__P_deploymentRandom__', t.deploymentRandom)

func stageParameters(stage object, t object) object =>
  union(
    toObject(items(stage.constants), item => item.key, item => { value: item.value }),
    toObject(items(stage.templated), item => item.key, item => { value: fill(item.value, t) }),
    toObject(items(stage.templatedJson), item => item.key, item => { value: json(fill(item.value, t)) }))

func subnetCidr(vnet string, entry array) string => cidrSubnet(vnet, entry[0], entry[1])

var stageName = 'aif-${prefixBare}-${scalesetNumber}'

resource bootstrapGroup 'Microsoft.Resources/resourceGroups@2024-07-01' = {
  name: bootstrapResourceGroup
  location: location
  tags: {
    CostCenter: costCenter
    Purpose: 'AIFactorySeeding'
  }
}

resource seedingVault 'Microsoft.Resources/deployments@2022-09-01' = {
  name: take('${stageName}-bootstrap-seeding-vault', 64)
  resourceGroup: bootstrapGroup.name
  properties: {
    mode: 'Incremental'
    templateLink: { relativePath: 'stages/portal-bootstrap.json' }
    parameters: stageParameters(stages['bootstrap-seeding-vault'], tokens)
  }
}

resource commonGroup 'Microsoft.Resources/deployments@2022-09-01' = {
  name: take('${stageName}-common-11-rgCommon', 64)
  location: location
  dependsOn: [seedingVault]
  properties: {
    mode: 'Incremental'
    templateLink: { relativePath: 'stages/11-rgCommon.json' }
    parameters: stageParameters(stages['common-11-rgCommon'], tokens)
  }
}

resource commonNetwork 'Microsoft.Resources/deployments@2022-09-01' = {
  name: take('${stageName}-common-12-networkCommon', 64)
  location: location
  dependsOn: [commonGroup]
  properties: {
    mode: 'Incremental'
    templateLink: { relativePath: 'stages/12-networkCommon.json' }
    parameters: stageParameters(stages['common-12-networkCommon'], tokens)
  }
}

resource commonResources 'Microsoft.Resources/deployments@2022-09-01' = {
  name: take('${stageName}-common-13-rgLevel', 64)
  location: location
  dependsOn: [commonNetwork]
  properties: {
    mode: 'Incremental'
    templateLink: { relativePath: 'stages/13-rgLevel.json' }
    parameters: union(stageParameters(stages['common-13-rgLevel'], tokens), {
      // enableAdminVM is false (SIMPLE_MODE_DISABLED); the template still declares the password.
      adminPassword: { value: '${toUpper(take(uniqueString(subscription().id, stageName, 'admin'), 6))}-${guid(subscription().id, stageName, 'unused-admin-vm')}' }
    })
  }
}

resource privateDns 'Microsoft.Resources/deployments@2022-09-01' = {
  name: take('${stageName}-hub-private-dns', 64)
  resourceGroup: commonResourceGroup
  dependsOn: [commonResources]
  properties: {
    mode: 'Incremental'
    templateLink: { relativePath: 'stages/createPrivateDnsZones.json' }
    parameters: stageParameters(stages['hub-private-dns'], tokens)
  }
}

resource privateDnsInitiative 'Microsoft.Resources/deployments@2022-09-01' = if (enablePrivateDnsPolicy) {
  name: take('${stageName}-hub-private-dns-initiative', 64)
  location: location
  dependsOn: [privateDns]
  properties: {
    mode: 'Incremental'
    templateLink: { relativePath: 'stages/28-Initiatives.json' }
    parameters: stageParameters(stages['hub-private-dns-initiative'], tokens)
  }
}

resource privateDnsPolicy 'Microsoft.Resources/deployments@2022-09-01' = if (enablePrivateDnsPolicy) {
  name: take('${stageName}-hub-private-dns-policy', 64)
  location: location
  dependsOn: [privateDnsInitiative]
  properties: {
    mode: 'Incremental'
    templateLink: { relativePath: 'stages/portal-private-dns-policy.json' }
    parameters: stageParameters(stages['hub-private-dns-policy'], tokens)
  }
}

resource hubAccess 'Microsoft.Resources/deployments@2022-09-01' = {
  name: take('${stageName}-hub-access', 64)
  resourceGroup: commonResourceGroup
  dependsOn: [privateDns]
  properties: {
    mode: 'Incremental'
    templateLink: { relativePath: 'stages/portal-hub-access.json' }
    parameters: union(stageParameters(stages['hub-access'], tokens), {
      resolverSubnetCidr: { value: subnetCidr(vnetCidr, subnets['snet-dns-private-resolver']) }
      vpnClientCidr: { value: vpnClientCidr }
      enableBastion: { value: enableBastion }
    })
  }
}

resource vpnGateway 'Microsoft.Resources/deployments@2022-09-01' = if (enableVpnGateway) {
  name: take('${stageName}-hub-vpn-gateway', 64)
  resourceGroup: commonResourceGroup
  dependsOn: [hubAccess]
  properties: {
    mode: 'Incremental'
    templateLink: { relativePath: 'stages/portal-vpn-gateway.json' }
    parameters: union(stageParameters(stages['hub-vpn-gateway'], tokens), {
      gatewaySubnetCidr: { value: subnetCidr(vnetCidr, subnets.GatewaySubnet) }
      vpnClientCidr: { value: vpnClientCidr }
    })
  }
}

resource appGatewayNetwork 'Microsoft.Resources/deployments@2022-09-01' = if (enableApplicationGateway) {
  name: take('${stageName}-hub-app-gateway-network', 64)
  resourceGroup: commonResourceGroup
  dependsOn: [hubAccess, vpnGateway]
  properties: {
    mode: 'Incremental'
    templateLink: { relativePath: 'stages/simple-app-gateway-network.json' }
    parameters: union(stageParameters(stages['hub-app-gateway-network'], tokens), {
      vpnClientCidr: { value: vpnClientCidr }
      certificateVaultId: { value: appGatewayCertificateVaultId }
    })
  }
}

var certificateVaultParts = split(empty(appGatewayCertificateVaultId) ? '/subscriptions/${subscription().subscriptionId}/resourceGroups/${commonResourceGroup}' : appGatewayCertificateVaultId, '/')

resource appGatewayCertificateRbac 'Microsoft.Resources/deployments@2022-09-01' = if (enableApplicationGateway) {
  name: take('${stageName}-hub-app-gateway-certificate-rbac', 64)
  subscriptionId: certificateVaultParts[2]
  resourceGroup: certificateVaultParts[4]
  properties: {
    mode: 'Incremental'
    templateLink: { relativePath: 'stages/portal-app-gateway-certificate-rbac.json' }
    parameters: union(stageParameters(stages['hub-app-gateway-certificate-rbac'], tokens), {
      certificateVaultId: { value: appGatewayCertificateVaultId }
      principalId: { value: appGatewayNetwork!.properties.outputs.principalId.value }
    })
  }
}

resource seedingEndpoint 'Microsoft.Resources/deployments@2022-09-01' = {
  name: take('${stageName}-hub-seeding-endpoint', 64)
  resourceGroup: commonResourceGroup
  dependsOn: [privateDns]
  properties: {
    mode: 'Incremental'
    templateLink: { relativePath: 'stages/portal-seeding-endpoint.json' }
    parameters: union(stageParameters(stages['hub-seeding-endpoint'], tokens), {
      keyVaultId: { value: seedingVault.properties.outputs.keyVaultId.value }
    })
  }
}

// --- Project 001: replaces subnetCalc_v2.ps1 with cidrSubnet() on the fixed Simple Mode /20 -------------

resource projectNetwork 'Microsoft.Resources/deployments@2022-09-01' = {
  name: take('${stageName}-project-31-network', 64)
  resourceGroup: commonResourceGroup
  dependsOn: [hubAccess, vpnGateway, appGatewayNetwork, seedingEndpoint, privateDnsPolicy]
  properties: {
    mode: 'Incremental'
    templateLink: { relativePath: 'stages/31-network.json' }
    parameters: union(stageParameters(stages['project-31-network'], tokens), {
      genaiSubnetCidr: { value: subnetCidr(vnetCidr, subnets.genai) }
      aksSubnetCidr: { value: subnetCidr(vnetCidr, subnets.aks) }
      aks2SubnetCidr: { value: subnetCidr(vnetCidr, subnets.aks2) }
      acaSubnetCidr: { value: subnetCidr(vnetCidr, subnets.aca) }
      aca2SubnetCidr: { value: subnetCidr(vnetCidr, subnets.aca2) }
      webappSubnetCidr: { value: subnetCidr(vnetCidr, subnets.webapp) }
      dbxPubSubnetCidr: { value: subnetCidr(vnetCidr, subnets.dbxpub) }
      dbxPrivSubnetCidr: { value: subnetCidr(vnetCidr, subnets.dbxpriv) }
    })
  }
}

// dynamicNetworkParams.json (genDynamicNetworkParamFile.ps1 reads the 31-network outputs)
var network = {
  genaiSubnetId: { value: projectNetwork.properties.outputs.genaiSubnetId.value }
  aksSubnetId: { value: projectNetwork.properties.outputs.aksSubnetId.value }
  aks2SubnetId: { value: projectNetwork.properties.outputs.aks2SubnetId.value }
  acaSubnetId: { value: projectNetwork.properties.outputs.acaSubnetId.value }
  aca2SubnetId: { value: projectNetwork.properties.outputs.aca2SubnetId.value }
  webappSubnetId: { value: projectNetwork.properties.outputs.webappSubnetId.value }
  dbxPubSubnetName: { value: projectNetwork.properties.outputs.dbxPubSubnetName.value }
  dbxPrivSubnetName: { value: projectNetwork.properties.outputs.dbxPrivSubnetName.value }
}
var searchNetwork = {
  genaiSubnetId: network.genaiSubnetId
  aksSubnetId: network.aksSubnetId
  acaSubnetId: network.acaSubnetId
  aca2SubnetId: network.aca2SubnetId
  aks2SubnetId: network.aks2SubnetId
}
var formChoices = {
  enableApplicationInsights: { value: enableApplicationInsights }
}

resource foundation 'Microsoft.Resources/deployments@2022-09-01' = {
  name: take('${stageName}-project-01-foundation', 64)
  location: location
  properties: {
    mode: 'Incremental'
    templateLink: { relativePath: 'stages/01-foundation.json' }
    parameters: union(stageParameters(stages['project-01-foundation'], tokens), network)
  }
}

