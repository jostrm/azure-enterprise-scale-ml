              "type": "string"
            },
            "runnerLocation": {
              "type": "string"
            },
            "vmIdentity": {
              "type": "object"
            },
            "consumerRoot": {
              "type": "string"
            },
            "pythonExecutable": {
              "type": "string"
            },
            "managedIdentityClientId": {
              "type": "string"
            },
            "projectSubscriptionId": {
              "type": "string"
            },
            "projectNumber": {
              "type": "string"
            },
            "configurationPath": {
              "type": "string"
            },
            "runId": {
              "type": "string"
            }
          },
          "variables": {
            "$fxv#0": "#!/usr/bin/env bash\nset -euo pipefail\n\n# Run only the operator-maintained checkout and Python; never fetch source or install the operator environment.\nexport AIF_CONSUMER_ROOT=\"${AIF_CONSUMER_ROOT:-/opt/esaf/consumer}\"\nexport AIF_PYTHON=\"${AIF_PYTHON:-$AIF_CONSUMER_ROOT/.venv-agent-operator/bin/python}\"\n[[ \"$AIF_CONSUMER_ROOT\" == /* && -d \"$AIF_CONSUMER_ROOT\" ]] || {\n  echo \"Factory project folder on VM must be an existing absolute Linux directory: $AIF_CONSUMER_ROOT. Prepare the standard folder /opt/esaf/consumer or set another folder in advanced settings.\" >&2\n  exit 2\n}\n[[ \"$AIF_PYTHON\" == /* && -f \"$AIF_PYTHON\" && -x \"$AIF_PYTHON\" ]] || {\n  echo \"Prepared Python on VM must be an existing absolute Python 3.12+ executable: $AIF_PYTHON. Prepare the standard executable $AIF_CONSUMER_ROOT/.venv-agent-operator/bin/python or set another executable in advanced settings; no system Python fallback or installation is performed.\" >&2\n  exit 2\n}\nadapter=\"$AIF_CONSUMER_ROOT/azure-enterprise-scale-ml/bootstrap/lib/agent_chat_portal.py\"\n[[ -f \"$adapter\" ]] || {\n  echo \"Update the prepared accelerator submodule: bootstrap/lib/agent_chat_portal.py is missing.\" >&2\n  exit 2\n}\n# The adapter validates configuration before its isolated managed-identity login, and owns cleanup and readiness.\nexec \"$AIF_PYTHON\" -B \"$adapter\"\n"
          },
          "resources": [
            {
              "type": "Microsoft.Compute/virtualMachines/runCommands",
              "apiVersion": "2024-11-01",
              "name": "[format('{0}/{1}', parameters('runnerVmName'), format('esaf-agent-chat-{0}', parameters('projectNumber')))]",
              "location": "[parameters('runnerLocation')]",
              "properties": {
                "asyncExecution": false,
                "treatFailureAsDeploymentFailure": true,
                "timeoutInSeconds": 14400,
                "source": {
                  "script": "[variables('$fxv#0')]"
                },
                "parameters": [
                  {
                    "name": "AIF_CONSUMER_ROOT",
                    "value": "[parameters('consumerRoot')]"
                  },
                  {
                    "name": "AIF_PROJECT_NUMBER",
                    "value": "[parameters('projectNumber')]"
                  },
                  {
                    "name": "AIF_PYTHON",
                    "value": "[parameters('pythonExecutable')]"
                  },
                  {
                    "name": "AIF_IDENTITY_CLIENT_ID",
                    "value": "[parameters('managedIdentityClientId')]"
                  },
                  {
                    "name": "AIF_SUBSCRIPTION_ID",
                    "value": "[parameters('projectSubscriptionId')]"
                  },
                  {
                    "name": "AIF_TENANT_ID",
                    "value": "[subscription().tenantId]"
                  },
                  {
                    "name": "AIF_CONFIGURATION_PATH",
                    "value": "[parameters('configurationPath')]"
                  },
                  {
                    "name": "AIF_RUN_ID",
                    "value": "[parameters('runId')]"
                  },
                  {
                    "name": "AIF_VM_IDENTITY",
                    "value": "[string(parameters('vmIdentity'))]"
                  }
                ]
              }
            }
          ],
          "outputs": {
            "runCommandResourceId": {
              "type": "string",
              "value": "[resourceId('Microsoft.Compute/virtualMachines/runCommands', parameters('runnerVmName'), format('esaf-agent-chat-{0}', parameters('projectNumber')))]"
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "runCommandResourceId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', format('esaf-agent-chat-{0}-{1}', parameters('projectNumber'), uniqueString(deployment().name))), '2022-09-01').outputs.runCommandResourceId.value]"
    },
    "results": {
      "type": "string",
      "value": "Read this Run Command instance view for resolved inputs, the application URL or failure details. The chat URL requires private network access and the configured Entra sign-in."
