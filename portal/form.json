{
  "$schema": "https://schema.management.azure.com/schemas/2021-09-09/uiFormDefinition.schema.json#",
  "view": {
    "kind": "Form",
    "properties": {
      "title": "AI Factory v1.25 - Simple Mode full bootstrap",
      "steps": [
        {
          "name": "basics",
          "label": "Basics",
          "elements": [
            {
              "name": "intro",
              "type": "Microsoft.Common.InfoBox",
              "options": {
                "style": "Info",
                "text": "AI Factory v1.25 Simple Mode full bootstrap: private networking, standalone topology with a dedicated integrated hub, bootstrap, common and project001 resource groups. Requires Owner (or Contributor plus User Access Administrator) on the subscription. Generated by portal/generate_portal.py; do not edit by hand."
              }
            },
            {
              "name": "subscription",
              "type": "Microsoft.Common.SubscriptionSelector"
            },
            {
              "name": "location",
              "type": "Microsoft.Common.LocationSelector",
              "label": "AI Factory region",
              "toolTip": "Regions supported by the v1.25 Simple Mode CLI and by Bastion Developer.",
              "allowedValues": [
                "eastus2",
                "germanywestcentral",
                "northeurope",
                "swedencentral",
                "uksouth",
                "westeurope"
              ],
              "scope": {
                "subscriptionId": "[steps('basics').subscription.subscriptionId]"
              }
            },
            {
              "name": "prefix",
              "type": "Microsoft.Common.TextBox",
              "label": "Naming prefix",
              "defaultValue": "aif",
              "toolTip": "2-16 lowercase letters, digits or hyphens. Resource groups become <prefix>-esml-common-<region>-dev-<nnn>.",
              "constraints": {
                "required": true,
                "regex": "^[a-z0-9-]{2,16}$",
                "validationMessage": "Use 2-16 lowercase letters, digits or hyphens."
              }
            },
            {
              "name": "scalesetNumber",
              "type": "Microsoft.Common.TextBox",
              "label": "Scale set number",
              "defaultValue": "001",
              "constraints": {
                "required": true,
                "regex": "^(00[1-9]|0[1-9][0-9]|[1-9][0-9]{2})$",
                "validationMessage": "Use three digits, 001-999."
              }
            },
            {
              "name": "costCenter",
              "type": "Microsoft.Common.TextBox",
              "label": "Cost center tag",
              "defaultValue": "123456",
              "constraints": {
                "required": true,
                "regex": "^[A-Za-z0-9_-]{1,64}$",
                "validationMessage": "1-64 letters, digits, underscores or hyphens."
              }
            }
          ]
        },
        {
          "name": "team",
          "label": "Team",
          "elements": [
            {
              "name": "teamInfo",
              "type": "Microsoft.Common.InfoBox",
              "options": {
                "style": "Info",
                "text": "The deployment never writes to Microsoft Entra ID. Create the team security group first and paste its object ID."
              }
            },
            {
              "name": "teamGroupObjectId",
              "type": "Microsoft.Common.TextBox",
              "label": "Team Entra group object ID",
              "constraints": {
                "required": true,
                "regex": "^[0-9a-fA-F]{8}-([0-9a-fA-F]{4}-){3}[0-9a-fA-F]{12}$",
                "validationMessage": "Paste the group's object ID (GUID)."
              }
            },
            {
              "name": "teamGroupName",
              "type": "Microsoft.Common.TextBox",
              "label": "Team Entra group display name",
              "defaultValue": "aif-prj001-team",
              "constraints": {
                "required": true,
                "regex": "^.{1,120}$",
                "validationMessage": "1-120 characters."
              }
            },
            {
              "name": "teamMemberEmail",
              "type": "Microsoft.Common.TextBox",
              "label": "Technical contact e-mail",
              "constraints": {
                "required": true,
                "regex": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
                "validationMessage": "Enter an e-mail address."
              }
            }
          ]
        },
        {
          "name": "services",
          "label": "Services",
          "elements": [
            {
              "name": "aiSearchLocation",
              "type": "Microsoft.Common.DropDown",
              "label": "AI Search region",
              "defaultValue": "Same as the AI Factory region",
              "toolTip": "Pick another region only if AI Search has no capacity in the main region. There is no automatic retry.",
              "constraints": {
                "required": true,
                "allowedValues": [
                  {
                    "label": "Same as the AI Factory region",
                    "value": "same-as-factory-region"
                  },
                  {
                    "label": "eastus2",
                    "value": "eastus2"
                  },
                  {
                    "label": "germanywestcentral",
                    "value": "germanywestcentral"
                  },
                  {
                    "label": "northeurope",
                    "value": "northeurope"
                  },
                  {
                    "label": "swedencentral",
                    "value": "swedencentral"
                  },
                  {
                    "label": "uksouth",
                    "value": "uksouth"
                  },
                  {
                    "label": "westeurope",
                    "value": "westeurope"
                  }
                ]
              }
            },
            {
              "name": "enableFoundry",
              "type": "Microsoft.Common.OptionsGroup",
              "label": "Microsoft Foundry S0",
              "defaultValue": "Yes",
              "constraints": {
                "allowedValues": [
                  {
                    "label": "Yes",
                    "value": "true"
                  },
                  {
                    "label": "No",
                    "value": "false"
                  }
                ],
                "required": true
              },
              "toolTip": "Optional private Foundry account and default project; requires capability host, Search and Cosmos DB. No model deployments.",
              "visible": "[and(equals(steps('services').enableAISearch, 'true'), equals(steps('services').enableCosmosDB, 'true'))]"
            },
            {
              "name": "enableAISearch",
              "type": "Microsoft.Common.OptionsGroup",
              "label": "AI Search",
              "defaultValue": "Yes",
              "constraints": {
                "allowedValues": [
                  {
                    "label": "Yes",
                    "value": "true"
                  },
                  {
                    "label": "No",
                    "value": "false"
                  }
                ],
                "required": true
              },
              "toolTip": "Basic-tier private search, independently selectable or required with Foundry."
            },
            {
              "name": "enableCosmosDB",
              "type": "Microsoft.Common.OptionsGroup",
              "label": "Azure Cosmos DB",
              "defaultValue": "Yes",
              "constraints": {
                "allowedValues": [
                  {
                    "label": "Yes",
                    "value": "true"
                  },
                  {
                    "label": "No",
                    "value": "false"
                  }
                ],
                "required": true
              },
              "toolTip": "Private database, independently selectable or required for Foundry agent history."
            },
            {
              "name": "enableApplicationInsights",
              "type": "Microsoft.Common.OptionsGroup",
              "label": "Application Insights",
              "defaultValue": "Yes",
              "constraints": {
                "allowedValues": [
                  {
                    "label": "Yes",
                    "value": "true"
                  },
                  {
                    "label": "No",
                    "value": "false"
                  }
                ],
                "required": true
              },
              "toolTip": "Optional workspace-based project telemetry; not private-only without AMPLS."
            },
            {
              "name": "enableAzureMachineLearning",
              "type": "Microsoft.Common.OptionsGroup",
              "label": "Azure Machine Learning",
              "defaultValue": "No",
              "constraints": {
                "allowedValues": [
                  {
                    "label": "Yes",
                    "value": "true"
                  },
                  {
                    "label": "No",
                    "value": "false"
                  }
                ],
                "required": true
              },
              "toolTip": "Private Basic workspace using canonical compute defaults; requires its linked Application Insights.",
              "visible": "[equals(steps('services').enableApplicationInsights, 'true')]"
            },
            {
              "name": "enableAksForAzureML",
              "type": "Microsoft.Common.OptionsGroup",
              "label": "AKS for Azure ML",
              "defaultValue": "No",
              "constraints": {
                "allowedValues": [
                  {
                    "label": "Yes",
                    "value": "true"
                  },
                  {
                    "label": "No",
                    "value": "false"
                  }
                ],
                "required": true
              },
              "toolTip": "AKS compute for the selected Azure Machine Learning workspace.",
              "visible": "[and(equals(steps('services').enableApplicationInsights, 'true'), equals(steps('services').enableAzureMachineLearning, 'true'))]"
            },
            {
              "name": "enableAKS",
              "type": "Microsoft.Common.OptionsGroup",
              "label": "Standalone AKS",
              "defaultValue": "No",
              "constraints": {
                "allowedValues": [
                  {
                    "label": "Yes",
                    "value": "true"
                  },
                  {
                    "label": "No",
                    "value": "false"
                  }
                ],
                "required": true
              },
              "toolTip": "Independent private AKS cluster; does not require Azure Machine Learning."
            },
            {
              "name": "enableDatabricks",
              "type": "Microsoft.Common.OptionsGroup",
              "label": "Azure Databricks",
              "defaultValue": "No",
              "constraints": {
                "allowedValues": [
                  {
                    "label": "Yes",
                    "value": "true"
                  },
                  {
                    "label": "No",
                    "value": "false"
                  }
                ],
                "required": true
              },
              "toolTip": "Private Premium workspace using the canonical project data platform."
            },
            {
              "name": "enableDatafactory",
              "type": "Microsoft.Common.OptionsGroup",
              "label": "Azure Data Factory",
              "defaultValue": "No",
              "constraints": {
                "allowedValues": [
                  {
                    "label": "Yes",
                    "value": "true"
                  },
                  {
                    "label": "No",
                    "value": "false"
                  }
                ],
                "required": true
              },
              "toolTip": "Project data pipelines with managed private endpoints."
            },
            {
              "name": "enableEventHubs",
              "type": "Microsoft.Common.OptionsGroup",
              "label": "Azure Event Hubs",
              "defaultValue": "No",
              "constraints": {
                "allowedValues": [
                  {
                    "label": "Yes",
                    "value": "true"
                  },
                  {
                    "label": "No",
                    "value": "false"
                  }
                ],
                "required": true
              },
              "toolTip": "Private event ingestion using Standard tier (required for Private Link)."
            },
            {
              "name": "enablePostgreSQL",
              "type": "Microsoft.Common.OptionsGroup",
              "label": "Azure Database for PostgreSQL",
              "defaultValue": "No",
              "constraints": {
                "allowedValues": [
                  {
                    "label": "Yes",
                    "value": "true"
                  },
                  {
                    "label": "No",
                    "value": "false"
                  }
                ],
                "required": true
              },
              "toolTip": "Private flexible server, Burstable Standard_B1ms."
            },
            {
              "name": "enableContainerApps",
              "type": "Microsoft.Common.OptionsGroup",
              "label": "Azure Container Apps",
              "defaultValue": "No",
              "constraints": {
                "allowedValues": [
                  {
                    "label": "Yes",
                    "value": "true"
                  },
                  {
                    "label": "No",
                    "value": "false"
                  }
                ],
                "required": true
              },
              "toolTip": "Private Container Apps environment using canonical project defaults and linked Application Insights.",
              "visible": "[equals(steps('services').enableApplicationInsights, 'true')]"
            },
            {
              "name": "aiSearchSku",
              "type": "Microsoft.Common.DropDown",
              "label": "AI Search tier (Dev)",
              "defaultValue": "basic",
              "constraints": {
                "required": true,
                "allowedValues": [
                  {
                    "label": "basic",
                    "value": "basic"
                  },
                  {
                    "label": "standard",
                    "value": "standard"
                  },
                  {
                    "label": "standard2",
                    "value": "standard2"
                  }
                ]
              }
            },
            {
              "name": "storageSku",
              "type": "Microsoft.Common.DropDown",
              "label": "Storage redundancy (Dev)",
              "defaultValue": "Standard_LRS",
              "constraints": {
                "required": true,
                "allowedValues": [
                  {
                    "label": "Standard_LRS",
                    "value": "Standard_LRS"
                  },
                  {
                    "label": "Standard_ZRS",
                    "value": "Standard_ZRS"
                  }
                ]
              }
            }
          ]
        },
        {
          "name": "hub",
          "label": "Networking options",
          "elements": [
            {
              "name": "hubInfo",
              "type": "Microsoft.Common.InfoBox",
              "options": {
                "style": "Info",
                "text": "Private networking is fixed: VNet 172.16.0.0/20, private endpoints, private DNS zones and a DNS Private Resolver inbound endpoint. The options below are billable or take 30-45 minutes and are off by default."
              }
            },
            {
              "name": "enableBastion",
              "type": "Microsoft.Common.OptionsGroup",
              "label": "Bastion Developer",
              "defaultValue": "Yes",
              "constraints": {
                "allowedValues": [
                  {
                    "label": "Yes",
                    "value": "true"
                  },
                  {
                    "label": "No",
                    "value": "false"
                  }
                ],
                "required": true
              },
              "toolTip": "Free shared Bastion; no admin VM is deployed."
            },
            {
              "name": "enablePrivateDnsPolicy",
              "type": "Microsoft.Common.OptionsGroup",
              "label": "Private DNS initiative",
              "defaultValue": "Yes",
              "constraints": {
                "allowedValues": [
                  {
                    "label": "Yes",
                    "value": "true"
                  },
                  {
                    "label": "No",
                    "value": "false"
                  }
                ],
                "required": true
              },
              "toolTip": "Assign Deploy-Private-DNS-Zones to this subscription, as the Simple Mode CLI does."
            },
            {
              "name": "enableVpnGateway",
              "type": "Microsoft.Common.OptionsGroup",
              "label": "Point-to-site VPN Gateway",
              "defaultValue": "No",
              "constraints": {
                "allowedValues": [
                  {
                    "label": "Yes",
                    "value": "true"
                  },
                  {
                    "label": "No",
                    "value": "false"
                  }
                ],
                "required": true
              },
              "toolTip": "VpnGw1AZ with Entra authentication. Billable; adds 30-45 minutes."
            },
            {
              "name": "vpnClientCidr",
              "type": "Microsoft.Common.TextBox",
              "label": "VPN client address pool",
              "defaultValue": "172.31.240.0/24",
              "visible": "[equals(steps('hub').enableVpnGateway, 'true')]",
              "constraints": {
                "required": true,
                "regex": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/(1[6-9]|2[0-9])$",
                "validationMessage": "IPv4 CIDR /16-/29 outside 172.16.0.0/20."
              }
            },
            {
              "name": "enableApplicationGateway",
              "type": "Microsoft.Common.OptionsGroup",
              "label": "Private Application Gateway WAF_v2",
              "defaultValue": "No",
              "constraints": {
                "allowedValues": [
                  {
                    "label": "Yes",
                    "value": "true"
                  },
                  {
                    "label": "No",
                    "value": "false"
                  }
                ],
                "required": true
              },
              "toolTip": "Billable. Needs a hostname, a private HTTPS backend and a Key Vault certificate."
            },
            {
              "name": "appGatewayHostname",
              "type": "Microsoft.Common.TextBox",
              "label": "Gateway HTTPS hostname",
              "visible": "[equals(steps('hub').enableApplicationGateway, 'true')]",
              "constraints": {
                "required": true,
                "regex": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.){2,}[a-z][a-z0-9-]{1,62}$",
                "validationMessage": "Use a custom FQDN such as ai.contoso.com."
              }
            },
            {
              "name": "appGatewayBackendFqdn",
              "type": "Microsoft.Common.TextBox",
              "label": "Private HTTPS backend FQDN",
              "visible": "[equals(steps('hub').enableApplicationGateway, 'true')]",
              "constraints": {
                "required": true,
                "regex": "^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z][a-z0-9-]{1,62}$",
                "validationMessage": "Use an FQDN, not an IP address or URL."
              }
            },
            {
              "name": "appGatewayCertificateSecretId",
              "type": "Microsoft.Common.TextBox",
              "label": "Versionless Key Vault certificate secret URI",
              "visible": "[equals(steps('hub').enableApplicationGateway, 'true')]",
              "constraints": {
                "required": true,
                "regex": "^https://[a-z0-9-]{3,24}\\.vault\\.azure\\.net/secrets/[A-Za-z0-9-]{1,127}$",
                "validationMessage": "Versionless https://<vault>.vault.azure.net/secrets/<name> URI."
              }
            },
            {
              "name": "appGatewayCertificateVaultId",
              "type": "Microsoft.Common.TextBox",
              "label": "Certificate Key Vault resource ID",
              "visible": "[equals(steps('hub').enableApplicationGateway, 'true')]",
              "constraints": {
                "required": true,
                "regex": "^/subscriptions/[^/]+/resourceGroups/[^/]+/providers/Microsoft.KeyVault/vaults/[^/]+$",
                "validationMessage": "Key Vault resource ID in this subscription."
              }
            }
          ]
        }
      ]
    },
    "outputs": {
      "kind": "Subscription",
      "subscriptionId": "[steps('basics').subscription.subscriptionId]",
      "location": "[steps('basics').location.name]",
      "parameters": {
        "location": "[steps('basics').location.name]",
        "prefix": "[steps('basics').prefix]",
        "scalesetNumber": "[steps('basics').scalesetNumber]",
        "costCenter": "[steps('basics').costCenter]",
        "teamGroupObjectId": "[steps('team').teamGroupObjectId]",
        "teamGroupName": "[steps('team').teamGroupName]",
        "teamMemberEmail": "[steps('team').teamMemberEmail]",
        "aiSearchLocation": "[steps('services').aiSearchLocation]",
        "enableFoundry": "[equals(steps('services').enableFoundry, 'true')]",
        "enableAISearch": "[equals(steps('services').enableAISearch, 'true')]",
        "enableCosmosDB": "[equals(steps('services').enableCosmosDB, 'true')]",
        "enableApplicationInsights": "[equals(steps('services').enableApplicationInsights, 'true')]",
        "enableAzureMachineLearning": "[equals(steps('services').enableAzureMachineLearning, 'true')]",
        "enableAksForAzureML": "[equals(steps('services').enableAksForAzureML, 'true')]",
        "enableAKS": "[equals(steps('services').enableAKS, 'true')]",
        "enableDatabricks": "[equals(steps('services').enableDatabricks, 'true')]",
        "enableDatafactory": "[equals(steps('services').enableDatafactory, 'true')]",
        "enableEventHubs": "[equals(steps('services').enableEventHubs, 'true')]",
        "enablePostgreSQL": "[equals(steps('services').enablePostgreSQL, 'true')]",
        "enableContainerApps": "[equals(steps('services').enableContainerApps, 'true')]",
        "aiSearchSku": "[steps('services').aiSearchSku]",
        "storageSku": "[steps('services').storageSku]",
        "enableBastion": "[equals(steps('hub').enableBastion, 'true')]",
        "enablePrivateDnsPolicy": "[equals(steps('hub').enablePrivateDnsPolicy, 'true')]",
        "enableVpnGateway": "[equals(steps('hub').enableVpnGateway, 'true')]",
        "vpnClientCidr": "[steps('hub').vpnClientCidr]",
        "enableApplicationGateway": "[equals(steps('hub').enableApplicationGateway, 'true')]",
        "appGatewayHostname": "[coalesce(steps('hub').appGatewayHostname, '')]",
        "appGatewayBackendFqdn": "[coalesce(steps('hub').appGatewayBackendFqdn, '')]",
        "appGatewayCertificateSecretId": "[coalesce(steps('hub').appGatewayCertificateSecretId, '')]",
        "appGatewayCertificateVaultId": "[coalesce(steps('hub').appGatewayCertificateVaultId, '')]"
      }
    }
  }
}
