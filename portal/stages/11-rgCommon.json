              }
            },
            "enableAIPromptEvidence": {
              "type": "bool",
              "defaultValue": false,
              "metadata": {
                "description": "Enable AIPromptEvidence extension for AI plan."
              }
            },
            "storageCapGBPerMonthPerStorageAccount": {
              "type": "string",
              "defaultValue": "5000",
              "metadata": {
                "description": "Storage scanning capacity limit (GB per month per storage account)."
              }
            },
            "enableStorageMalwareScanning": {
              "type": "bool",
              "defaultValue": true,
              "metadata": {
                "description": "Enable OnUploadMalwareScanning extension for Storage."
              }
            },
            "enableStorageSensitiveDataDiscovery": {
              "type": "bool",
              "defaultValue": true,
              "metadata": {
                "description": "Enable SensitiveDataDiscovery extension for Storage."
              }
            },
            "enableDefenderForContainers": {
              "type": "bool",
              "defaultValue": false,
              "metadata": {
                "description": "Optional. Enable Defender for Containers."
              }
            },
            "enableContainerRegistriesVulnerabilityAssessments": {
              "type": "bool",
              "defaultValue": false,
              "metadata": {
                "description": "Enable ContainerRegistriesVulnerabilityAssessments extension for Containers/CloudPosture."
              }
            },
            "enableContainerSensor": {
              "type": "bool",
              "defaultValue": false,
              "metadata": {
                "description": "Enable ContainerSensor extension for Containers plan."
              }
            },
            "enableAgentlessDiscoveryForKubernetes": {
              "type": "bool",
              "defaultValue": false,
              "metadata": {
                "description": "Enable AgentlessDiscoveryForKubernetes extension for Containers/CloudPosture."
              }
            },
            "enableDefenderForCloudPosture": {
              "type": "bool",
              "defaultValue": false,
              "metadata": {
                "description": "Optional. Enable Defender for Cloud Posture Management."
              }
            },
            "enableDefenderForVirtualMachines": {
              "type": "bool",
              "defaultValue": false,
              "metadata": {
                "description": "Optional. Enable Defender for Virtual Machines."
              }
            },
            "vmSubPlan": {
              "type": "string",
              "defaultValue": "P2",
              "allowedValues": [
                "P1",
                "P2",
                ""
              ],
              "metadata": {
                "description": "Sub-plan for Virtual Machines (P1 or P2)."
              }
            },
            "enableMdeDesignatedSubscription": {
              "type": "bool",
              "defaultValue": false,
              "metadata": {
                "description": "Enable MdeDesignatedSubscription extension for VirtualMachines plan."
              }
            }
          },
          "resources": [
            {
              "condition": "[or(parameters('enableAll'), parameters('enableDefenderForAI'))]",
              "type": "Microsoft.Security/pricings",
              "apiVersion": "2024-01-01",
              "name": "[parameters('aiPlanName')]",
              "properties": {
                "pricingTier": "[parameters('pricingTier')]",
                "enforce": "[parameters('enforce')]",
                "subPlan": "[if(not(empty(parameters('aiSubPlan'))), parameters('aiSubPlan'), null())]",
                "extensions": "[if(and(equals(parameters('pricingTier'), 'Standard'), parameters('enableAIPromptEvidence')), createArray(createObject('name', 'AIPromptEvidence', 'isEnabled', 'True')), createArray())]"
              }
            },
            {
              "condition": "[or(parameters('enableAll'), parameters('enableDefenderForStorage'))]",
              "type": "Microsoft.Security/pricings",
              "apiVersion": "2024-01-01",
              "name": "StorageAccounts",
              "properties": {
                "pricingTier": "[parameters('advancedPricingTier')]",
                "enforce": "[parameters('enforce')]",
                "subPlan": "[if(equals(parameters('advancedPricingTier'), 'Standard'), 'DefenderForStorageV2', null())]",
                "extensions": "[if(equals(parameters('advancedPricingTier'), 'Standard'), concat(if(parameters('enableStorageMalwareScanning'), createArray(createObject('name', 'OnUploadMalwareScanning', 'isEnabled', 'True', 'additionalExtensionProperties', createObject('CapGBPerMonthPerStorageAccount', parameters('storageCapGBPerMonthPerStorageAccount')))), createArray()), if(parameters('enableStorageSensitiveDataDiscovery'), createArray(createObject('name', 'SensitiveDataDiscovery', 'isEnabled', 'True')), createArray())), createArray())]"
              }
            },
            {
              "condition": "[or(parameters('enableAll'), parameters('enableDefenderForKeyVault'))]",
              "type": "Microsoft.Security/pricings",
              "apiVersion": "2024-01-01",
              "name": "KeyVaults",
              "properties": {
                "pricingTier": "[parameters('pricingTier')]",
                "enforce": "[parameters('enforce')]"
              }
            },
            {
              "condition": "[or(parameters('enableAll'), parameters('enableDefenderForContainers'))]",
              "type": "Microsoft.Security/pricings",
              "apiVersion": "2024-01-01",
              "name": "Containers",
              "properties": {
                "pricingTier": "[parameters('advancedPricingTier')]",
                "enforce": "[parameters('enforce')]",
                "extensions": "[if(equals(parameters('advancedPricingTier'), 'Standard'), concat(if(parameters('enableContainerRegistriesVulnerabilityAssessments'), createArray(createObject('name', 'ContainerRegistriesVulnerabilityAssessments', 'isEnabled', 'True')), createArray()), if(parameters('enableContainerSensor'), createArray(createObject('name', 'ContainerSensor', 'isEnabled', 'True')), createArray()), if(parameters('enableAgentlessDiscoveryForKubernetes'), createArray(createObject('name', 'AgentlessDiscoveryForKubernetes', 'isEnabled', 'True')), createArray())), createArray())]"
              }
            },
            {
              "condition": "[or(parameters('enableAll'), parameters('enableDefenderForCloudPosture'))]",
              "type": "Microsoft.Security/pricings",
              "apiVersion": "2024-01-01",
              "name": "CloudPosture",
              "properties": {
                "pricingTier": "[parameters('advancedPricingTier')]",
                "enforce": "[parameters('enforce')]",
                "extensions": "[if(and(equals(parameters('advancedPricingTier'), 'Standard'), parameters('enableAgentlessDiscoveryForKubernetes')), createArray(createObject('name', 'AgentlessDiscoveryForKubernetes', 'isEnabled', 'True')), createArray())]"
              }
            },
            {
              "condition": "[or(parameters('enableAll'), parameters('enableDefenderForVirtualMachines'))]",
              "type": "Microsoft.Security/pricings",
              "apiVersion": "2024-01-01",
              "name": "VirtualMachines",
              "properties": {
                "pricingTier": "[parameters('advancedPricingTier')]",
                "enforce": "[parameters('enforce')]",
                "subPlan": "[if(and(equals(parameters('advancedPricingTier'), 'Standard'), not(empty(parameters('vmSubPlan')))), parameters('vmSubPlan'), null())]",
                "extensions": "[if(and(equals(parameters('advancedPricingTier'), 'Standard'), parameters('enableMdeDesignatedSubscription')), createArray(createObject('name', 'MdeDesignatedSubscription', 'isEnabled', 'True')), createArray())]"
              }
            }
          ],
          "outputs": {
            "defenderForAIEnabled": {
              "type": "bool",
              "metadata": {
                "description": "Defender for AI enabled."
              },
              "value": "[or(parameters('enableAll'), parameters('enableDefenderForAI'))]"
            },
            "defenderForStorageEnabled": {
              "type": "bool",
              "metadata": {
                "description": "Defender for Storage enabled."
              },
              "value": "[or(parameters('enableAll'), parameters('enableDefenderForStorage'))]"
            },
            "defenderForKeyVaultEnabled": {
              "type": "bool",
              "metadata": {
                "description": "Defender for Key Vault enabled."
              },
              "value": "[or(parameters('enableAll'), parameters('enableDefenderForKeyVault'))]"
            },
            "aiPromptEvidenceEnabled": {
              "type": "bool",
              "metadata": {
                "description": "AI Prompt Evidence extension enabled."
              },
              "value": "[and(and(or(parameters('enableAll'), parameters('enableDefenderForAI')), equals(parameters('pricingTier'), 'Standard')), parameters('enableAIPromptEvidence'))]"
            },
            "storageMalwareScanningEnabled": {
              "type": "bool",
              "metadata": {
                "description": "Storage Malware Scanning extension enabled."
              },
              "value": "[parameters('enableStorageMalwareScanning')]"
            },
            "storageSensitiveDataDiscoveryEnabled": {
              "type": "bool",
              "metadata": {
                "description": "Storage Sensitive Data Discovery extension enabled."
              },
              "value": "[parameters('enableStorageSensitiveDataDiscovery')]"
            },
            "defenderForContainersEnabled": {
              "type": "bool",
              "metadata": {
                "description": "Defender for Containers enabled."
              },
              "value": "[or(parameters('enableAll'), parameters('enableDefenderForContainers'))]"
            },
            "containerRegistriesVulnerabilityAssessmentsEnabled": {
              "type": "bool",
              "metadata": {
                "description": "Container Registries Vulnerability Assessments extension enabled."
              },
              "value": "[parameters('enableContainerRegistriesVulnerabilityAssessments')]"
            },
            "containerSensorEnabled": {
              "type": "bool",
              "metadata": {
                "description": "Container Sensor extension enabled."
              },
              "value": "[parameters('enableContainerSensor')]"
            },
            "agentlessDiscoveryForKubernetesEnabled": {
              "type": "bool",
              "metadata": {
                "description": "Agentless Discovery For Kubernetes extension enabled."
              },
              "value": "[parameters('enableAgentlessDiscoveryForKubernetes')]"
            },
            "defenderForCloudPostureEnabled": {
              "type": "bool",
              "metadata": {
                "description": "Defender for Cloud Posture enabled."
              },
              "value": "[or(parameters('enableAll'), parameters('enableDefenderForCloudPosture'))]"
            },
            "defenderForVirtualMachinesEnabled": {
              "type": "bool",
              "metadata": {
                "description": "Defender for Virtual Machines enabled."
              },
              "value": "[or(parameters('enableAll'), parameters('enableDefenderForVirtualMachines'))]"
            },
            "mdeDesignatedSubscriptionEnabled": {
              "type": "bool",
              "metadata": {
                "description": "MDE Designated Subscription extension enabled."
              },
              "value": "[parameters('enableMdeDesignatedSubscription')]"
            }
          }
        }
      },
      "dependsOn": [
        "[subscriptionResourceId(variables('subscriptionIdDevTestProd'), 'Microsoft.Resources/deployments', format('CommonRG{0}-depl{1}{2}{3}{4}', parameters('env'), parameters('commonRGNamePrefix'), parameters('env'), parameters('aifactorySuffixRG'), parameters('locationSuffix')))]"
      ]
    }
  ]
}