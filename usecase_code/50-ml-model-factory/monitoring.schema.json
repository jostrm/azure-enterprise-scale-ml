{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Factory monitoring report v1",
  "type": "object",
  "required": ["schema", "source", "scope", "subject", "generated_at", "window", "expires_at", "summary", "metrics", "limitations"],
  "properties": {
    "schema": {"const": "aifactory.monitoring/v1"},
    "source": {"enum": ["ml-model-factory", "agent-factory"]},
    "scope": {
      "type": "object",
      "required": ["aifactory", "project", "environment"],
      "properties": {
        "aifactory": {"type": "string", "minLength": 1},
        "project": {"type": "string", "pattern": "^[0-9]{3}$"},
        "environment": {"enum": ["dev", "test", "prod"]}
      }
    },
    "subject": {
      "type": "object",
      "required": ["kind", "name", "version", "task_type"],
      "properties": {
        "kind": {"enum": ["model", "agent"]},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "task_type": {"type": "string", "minLength": 1}
      }
    },
    "generated_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "window": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"}
      }
    },
    "summary": {
      "type": "object",
      "required": ["status", "data_drift", "concept_drift"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "data_drift": {"$ref": "#/$defs/status"},
        "concept_drift": {"$ref": "#/$defs/status"}
      }
    },
    "metrics": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["name", "value", "unit", "status"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "value": {"type": ["number", "null"]},
          "unit": {"type": "string"},
          "status": {"$ref": "#/$defs/status"},
          "detail": {"type": "string"}
        }
      }
    },
    "details": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "status": {"enum": ["healthy", "warning", "drift", "insufficient_data", "not_supported", "stale", "unknown"]}
  }
}
