#Foundry Project Endpoint (Foundry portal > project > Overview > Endpoint)
endpoint = "https://<foundry-account>.services.ai.azure.com/api/projects/<project>"

#Model (name of a chat model deployment in the Foundry account)
model_deployment_name = "<model-deployment>"

#Knowledgebase (Foundry IQ): MCP endpoint of the Azure AI Search knowledge base and its project connection
server_label = "<kb-label>"
server_url = "https://<search-service>.search.windows.net/knowledgebases/<knowledge-base>/mcp?api-version=2026-08-01-preview"
project_connection_id = "<kb-project-connection-name>"

#Setup only (setup_knowledge.py creates the project connection above): Foundry project ARM resource id
project_resource_id = "/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.CognitiveServices/accounts/<foundry-account>/projects/<project>"

#Fabric Data Agent (Fabric IQ): Foundry project connection to a published Fabric data agent. Leave empty to skip Inventory-Agent.
fabric_connection_name = ""
