# Copy to .env. This file contains NO customer defaults or credentials.
# The selected .env file is authoritative; unrelated shell settings are not merged.
AZURE_TENANT_ID=<tenant-guid>
AZURE_SUBSCRIPTION_ID=<subscription-guid>
# Optional diagnostics: RG is not a Fabric access grant; expected user must be a USER login.
AZURE_RESOURCE_GROUP=
AZURE_EXPECTED_USER=
# Informational for your administrator, not browser authentication or automatic role assignment.
TEAM_GROUP_ID=

# Foundry portal: project overview, project endpoint (not a model deployment endpoint).
FOUNDRY_PROJECT_ENDPOINT=https://<account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_AGENT_NAME=fabric-sales-assistant
# Set from the explicit Publish command. Runtime always invokes this exact persisted version.
FOUNDRY_AGENT_VERSION=
# Existing chat deployment name, needed only when publishing an agent version.
FOUNDRY_MODEL_DEPLOYMENT=

# Fabric published Data Agent: Settings -> Model Context Protocol. Not Fabric Core or an IQ URL.
FABRIC_MCP_URL=https://api.fabric.microsoft.com/v1/mcp/workspaces/<workspace-guid>/dataagents/<data-agent-guid>/agent
# Optional exact name and question argument from Discover. The sole question tool is discovered at runtime.
MCP_TOOL_NAME=
MCP_QUESTION_ARGUMENT=
# Path relative to this .env, not your terminal directory. Store customer edits as domain.local.json.
DOMAIN_CONFIG_PATH=config/domain.json

# Text works without any voice settings. Enable only after verifying service/model/region availability.
VOICE_ENABLED=false
VOICE_ENDPOINT=https://<account>.services.ai.azure.com
# Supported native families: gpt-realtime, gpt-realtime-mini, gpt-realtime-datazone.
# Choose an available supported model; availability and processing geography must be approved privately.
VOICE_MODEL=
# Native voice, for example alloy. No separate TTS credentials or upload/transcription workflow.
VOICE_NAME=
VOICE_API_VERSION=2026-07-15

# Fabric IQ is deliberately not included. Baseline uses the Data Agent's own MCP.
